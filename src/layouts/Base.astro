---
import '../styles/global.css';
export interface Props { title?: string; currentSlug?: string; description?: string; }
const { title = 'EnglishNotes', currentSlug = '', description = '' } = Astro.props;

const modules = import.meta.glob('../data/grammar/*.json', { eager: true, import: 'default' });
const topics = Object.values(modules).sort((a, b) => String(a.slug).localeCompare(String(b.slug)));
const total = topics.length;

// `/_vercel/insights/script.js` отдаёт только платформа Vercel — подключаем
// его лишь при продакшен-сборке на Vercel, чтобы локально не было 404
const vercelAnalytics = import.meta.env.PROD && process.env.VERCEL === '1';
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/png" sizes="192x192" href="/images/favicon-192.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="shortcut icon" type="image/png" href="/images/favicon-32.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700;800;900&family=Lora:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600;700;800&display=swap" rel="stylesheet" />
          <script>
      (function() {
        var STYLE_KEY = 'englishnotes.style.v1';
        var saved = 'classic';
        try { saved = localStorage.getItem(STYLE_KEY) || 'classic'; } catch(e) {}
        if (saved === 'rocknroll') {
          document.documentElement.classList.add('is-rock-preload');
        }
      })();
    </script>
    <style>
      html.is-rock-preload body { opacity: 0; }
      html.is-rock-preload body.is-rock,
      html.is-rock-preload body:not(.is-rock) { opacity: 1; transition: opacity 0.1s; }
    </style>
    {vercelAnalytics && <script defer src="/_vercel/insights/script.js"></script>}
  </head>
  <body data-topics-total={total} data-current-slug={currentSlug}>
        <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <defs>
        <filter id="sketch-rough" x="-20%" y="-20%" width="140%" height="140%">
          <feTurbulence type="fractalNoise" baseFrequency="0.018 0.024" numOctaves="2" seed="7" result="noise"/>
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="1.2" xChannelSelector="R" yChannelSelector="G"/>
        </filter>
      </defs>
    </svg>
    <header class="site-head">
      <div class="wrap site-head__inner">
        <a href="/" class="brand"><span class="brand__word">English<b>Notes</b></span></a>
        <div class="head-search" data-search role="search">
          <svg class="head-search__ico" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="M16.5 16.5 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          <input
            class="head-search__input"
            type="search"
            placeholder="Поиск по сайту…"
            aria-label="Поиск по урокам, заметкам и словам"
            autocomplete="off"
            spellcheck="false"
            enterkeyhint="search"
            data-search-input
          />
          <div class="head-search__drop" data-search-drop hidden></div>
        </div>
        <div class="site-head__menu">
          <details class="nav-toggle">
            <summary class="nav-toggle__button" aria-label="Открыть меню">
              <span class="nav-toggle__line"></span>
              <span class="nav-toggle__line"></span>
              <span class="nav-toggle__line"></span>
            </summary>
            <nav class="nav">
              <a href="/">Главная</a>
              <a href="/grammar">Грамматика</a>
              <a href="/notes">Заметки</a>
              <a href="/vocabulary" class="nav__link">Слова</a>
              <a href="/soon">Аудирование</a>
              <a href="/soon">Говорение</a>
              <a href="/soon">Прогресс</a>
            </nav>
          </details>
          <nav class="nav nav--desktop">
            <a href="/">Главная</a>
            <a href="/grammar">Грамматика</a>
            <a href="/notes">Заметки</a>
            <a href="/vocabulary" class="nav__link">Слова</a>
            <a href="/soon">Аудирование</a>
            <a href="/soon">Говорение</a>
            <a href="/soon">Прогресс</a>
          </nav>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap site-foot__inner">
        <span><span class="brand__word">English<b>Notes</b></span> — <b>Начни свою историю</b></span>
        <span class="muted"><b>Directed by © St.S.&nbsp;&nbsp;&nbsp;<span id="foot-year"></span></b></span>
      </div>
    </footer>

    <script>
      const STORE = 'englishnotes.progress.v1';
      const read = () => { try { return JSON.parse(localStorage.getItem(STORE) || '{}'); } catch { return {}; } };
      const write = (d) => localStorage.setItem(STORE, JSON.stringify(d));
      const load = () => { const d = read(); return { completed: new Set(d.completed || []), favorites: new Set(d.favorites || []) }; };
      const save = (s) => { write({ completed: [...s.completed], favorites: [...s.favorites] }); document.dispatchEvent(new CustomEvent('progress:change', { detail: s })); };
      const total = parseInt(document.body.dataset.topicsTotal || '0', 10);
      const cur = document.body.dataset.currentSlug || '';

      function paintButtons(slug, s) {
        document.querySelectorAll('[data-action][data-slug="' + slug + '"]').forEach((b) => {
          const set = b.dataset.action === 'favorite' ? s.favorites : s.completed;
          const on = set.has(slug);
          b.classList.toggle('is-on', on);
          b.setAttribute('aria-pressed', String(on));
          if (b.dataset.action === 'complete') { b.textContent = on ? 'Изучено ✓' : 'Отметить изученным'; }
          if (b.dataset.action === 'favorite') { b.textContent = on ? 'В избранном ★' : 'В избранное'; }
        });
      }

      let state = load();
      document.querySelectorAll('[data-action]').forEach((b) => {
        b.addEventListener('click', () => {
          const slug = b.dataset.slug;
          state = load();
          const set = b.dataset.action === 'favorite' ? state.favorites : state.completed;
          set.has(slug) ? set.delete(slug) : set.add(slug);
          save(state);
          paintButtons(slug, state);
        });
      });
      if (cur) paintButtons(cur, state);

      const markCards = (s) => {
        document.querySelectorAll('.topic-card[href]').forEach((c) => {
          const sl = (c.getAttribute('href') || '').replace('/grammar/', '');
          c.classList.toggle('is-done', s.completed.has(sl));
          c.classList.toggle('is-fav', s.favorites.has(sl));
        });
      };
      markCards(state);

      window.addEventListener('pageshow', () => {
        const s = load();
        markCards(s);
        if (cur) paintButtons(cur, s);
      });

      // level navigation: smooth scroll + scroll-spy (catalog only)
      const levelLinks = Array.from(document.querySelectorAll('[data-level-link]'));
      if (levelLinks.length) {
        // Горизонтальная лента уровней, которой управляет спай: на /grammar —
        // .catalog__nav, на /notes — .cheats-lvls (оба в разметке — первые
        // элементы секции). Контейнер ищем один на страницу: все чипы
        // data-level-link лежат в одной ленте.
        const levelNav = levelLinks[0].closest('.catalog__nav, .cheats-lvls') || null;
        const blocks = Array.from(document.querySelectorAll('[data-level-block]'));
        const setActive = (lvl, autoscroll) => {
          levelLinks.forEach((a) => a.classList.toggle('is-active', a.dataset.level === lvl));
          if (autoscroll) {
            const act = levelLinks.filter((a) => a.dataset.level === lvl)[0];
            if (act && levelNav && levelNav.scrollWidth > levelNav.clientWidth) {
              const nr = levelNav.getBoundingClientRect();
              const ar = act.getBoundingClientRect();
              levelNav.scrollTo({ left: levelNav.scrollLeft + (ar.left - nr.left) - (levelNav.clientWidth - ar.width) / 2, behavior: 'smooth' });
            }
          }
        };
        let ignoreSpy = false;
        let lastLvl = '';
        levelLinks.forEach((a) => {
          a.addEventListener('click', (e) => {
            e.preventDefault();
            const lvl = a.dataset.level;
            ignoreSpy = true;
            setActive(lvl);
            lastLvl = lvl === 'all' ? levelLinks[0].dataset.level : lvl;
            if (lvl === 'all') {
              window.scrollTo({ top: 0, behavior: 'smooth' });
              history.replaceState(null, '', location.pathname);
            } else {
              const t = document.getElementById(lvl);
              if (t) {
                const y = t.getBoundingClientRect().top + window.scrollY - 92;
                window.scrollTo({ top: y, behavior: 'smooth' });
                history.replaceState(null, '', '#' + lvl);
              }
            }
            setTimeout(() => { ignoreSpy = false; }, 700);
          });
        });
        // Активный уровень = последний блок, чей верх поднялся выше линии
        // чтения (30% высоты окна — верх прежней полосы rootMargin).
        // Пока страница выше всех блоков (начало страницы), активен первый
        // уровень: A0 подсвечен сразу и не гаснет при старте скролла.
        // Пересчёт также на pageshow/visibilitychange — возврат из другой
        // вкладки или bfcache без события scroll.
        if (blocks.length) {
          const line = () => window.innerHeight * 0.3;
          // Достигнут конец страницы: последний блок может быть короче
          // расстояния до линии чтения (top так и не поднимется выше 30%
          // высоты окна) — тогда активен последний пункт, иначе на /notes
          // C2 внизу страницы никогда не подсвечивался бы.
          const atBottom = () =>
            window.scrollY + window.innerHeight >= Math.max(document.documentElement.scrollHeight, document.body.scrollHeight) - 4;
          const spyLevel = () => {
            if (atBottom()) return blocks[blocks.length - 1].id;
            let cur = '';
            for (const b of blocks) {
              if (b.getBoundingClientRect().top <= line()) cur = b.id;
            }
            return cur || levelLinks[0].dataset.level;
          };
          const initHash = location.hash.replace('#', '');
          lastLvl = lastLvl || (initHash && document.getElementById(initHash) ? initHash : spyLevel());
          const updateSpy = () => {
            if (ignoreSpy) return;
            const lvl = spyLevel();
            const changed = lvl !== lastLvl;
            setActive(lvl, changed); // лента автопрокручивается только при смене уровня
            lastLvl = lvl;
            const atTop = lvl === levelLinks[0].dataset.level && window.scrollY < 40;
            history.replaceState(null, '', atTop ? location.pathname : '#' + lvl);
          };
          let ticking = false;
          const onScroll = () => {
            if (ignoreSpy || ticking) return;
            ticking = true;
            requestAnimationFrame(() => { ticking = false; updateSpy(); });
          };
          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('pageshow', onScroll);
          document.addEventListener('visibilitychange', () => {
            if (document.visibilityState === 'visible') onScroll();
          });
          // При заходе по якорю (#C2) сразу центрируем ленту на нужном
          // уровне, иначе выбранный чип останется за краем экрана.
          setActive(lastLvl, !!initHash && !!document.getElementById(initHash));
        }
      }

      // Мобильное меню (<details class="nav-toggle">): закрывается не только
      // крестиком, но и кликом по любой области вне меню, и клавишей Escape.
      const navToggle = document.querySelector('.nav-toggle');
      if (navToggle) {
        document.addEventListener('click', (e) => {
          if (navToggle.open && !navToggle.contains(e.target)) navToggle.open = false;
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && navToggle.open) navToggle.open = false;
        });
      }

      // scroll reveal
      const io = new IntersectionObserver((entries) => {
        entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
      }, { threshold: 0.12 });
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
      var fy = document.getElementById('foot-year');
      if (fy) { fy.textContent = String(new Date().getFullYear()); }
    </script>

    <script>
      // Глобальный поиск по сайту: статический индекс /search.json собирается
      // при сборке (src/pages/search.json.ts), здесь он фильтруется на лету.
      // Подсказки открываются под полем; выбор стрелками + Enter, закрытие —
      // Escape или клик вне поля.
      (function () {
        var root = document.querySelector('[data-search]');
        var input = root && root.querySelector('[data-search-input]');
        var drop = root && root.querySelector('[data-search-drop]');
        if (!root || !input || !drop) return;

        // на узких экранах плейсхолдер короче, чтобы не обрезался
        var shortPh = window.matchMedia('(max-width: 640px)');
        var setPh = function () { input.placeholder = shortPh.matches ? 'Поиск…' : 'Поиск по сайту…'; };
        setPh();
        shortPh.addEventListener ? shortPh.addEventListener('change', setPh) : shortPh.addListener(setPh);

        var GROUP = {
          g: { label: 'Уроки грамматики', cls: 'is-g' },
          n: { label: 'Заметки', cls: 'is-n' },
          v: { label: 'Слова', cls: 'is-v' }
        };
        var items = [];
        var cur = 0;          // индекс активной строки в текущем списке
        var curList = [];     // отфильтрованные записи в порядке показа

        // Контентный поиск по урокам: ленивый индекс /search-content.json
        // (текст повествований классики и рока под одним slug), кэш в
        // localStorage, чтобы не тянуть большой файл на каждой странице.
        var contentKey = 'englishnotes.search-content.v1';
        var contentIdx = [];
        var contentMeta = {};
        var contentPromise = null;
        var contentDone = false;

        var esc = function (s) {
          return String(s).replace(/[&<>"']/g, function (c) {
            return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
          });
        };

        // Ранг записи: выше — префикс названия, затем префикс формы/перевода
        // слова (вторая/третья формы, русский перевод), потом «содержит».
        // Короткий запрос (1 символ) показывает только префиксные совпадения,
        // чтобы слова из словаря не заливали список.
        var rank = function (it, q, qq) {
          var title = (it.title || '').toLowerCase();
          var titlePre = title.indexOf(q) === 0 || (qq !== q && title.indexOf(qq) === 0);
          if (titlePre) return 0;
          var fields = (it.f || []).map(String);
          for (var fi = 0; fi < fields.length; fi++) {
            var f = fields[fi].toLowerCase();
            if (f.indexOf(q) === 0 || (qq !== q && f.indexOf(qq) === 0)) return 1;
          }
          if (q.length < 2) return 9;
          var sub = ((it.sub || '') + ' ' + (it.d || '')).toLowerCase();
          var titleHit = title.indexOf(q) !== -1 || (qq !== q && title.indexOf(qq) !== -1);
          var subPre = sub.indexOf(q) === 0 || (qq !== q && sub.indexOf(qq) === 0);
          if (titleHit || subPre) return 2;
          if (sub.indexOf(q) !== -1 || (qq !== q && sub.indexOf(qq) !== -1)) return 3;
          return 9;
        };

        // Кириллица -> латиница: чтобы по-русски можно было искать латинские
        // имена/названия из уроков («оффспринг» -> offspring). Для неоднозначных
        // букв (ж, х, ц, ю, я, ...) генерируем несколько вариантов.
        var CYR_LAT = {
          'а': 'a', 'б': 'b', 'в': 'v', 'г': 'g', 'д': 'd', 'е': 'e',
          'ё': ['yo', 'e'], 'ж': ['zh', 'j'], 'з': 'z', 'и': 'i',
          'й': ['y', 'i', 'j'], 'к': 'k', 'л': 'l', 'м': 'm', 'н': 'n',
          'о': 'o', 'п': 'p', 'р': 'r', 'с': 's', 'т': 't', 'у': 'u',
          'ф': 'f', 'х': ['kh', 'h'], 'ц': ['ts', 'c'], 'ч': ['ch'],
          'ш': ['sh'], 'щ': ['shch', 'sch'], 'ъ': '', 'ы': 'y', 'ь': '',
          'э': ['e'], 'ю': ['yu', 'u', 'iu'], 'я': ['ya', 'ia', 'a']
        };
        var translitVariants = function (s) {
          var parts = [];
          for (var ci = 0; ci < s.length; ci++) {
            var ch = s.charAt(ci);
            var v = CYR_LAT[ch];
            if (!v) { parts.push([ch]); continue; }
            parts.push(typeof v === 'string' ? [v] : v);
          }
          var res = [''];
          for (var pi = 0; pi < parts.length; pi++) {
            var next = [];
            for (var ri = 0; ri < res.length; ri++) {
              for (var vi = 0; vi < parts[pi].length; vi++) {
                next.push(res[ri] + parts[pi][vi]);
                if (next.length > 30) break;
              }
              if (next.length > 30) break;
            }
            res = next;
          }
          return res;
        };

        var render = function () {
          var q = input.value.trim().toLowerCase();
          if (q.length === 0) { drop.hidden = true; drop.innerHTML = ''; return; }
          var qq = q.replace(/[ьъ]/g, ''); // мягкий поиск по русским окончаниям
          if (qq.length < 2) qq = q;
          var hits = [];
          for (var i = 0; i < items.length; i++) {
            var it = items[i];
            var hay = (it.title + ' ' + (it.sub || '') + ' ' + (it.d || '') + ' ' + (it.lvl)).toLowerCase();
            if (hay.indexOf(q) === -1 && (qq === q || hay.indexOf(qq) === -1)) continue;
            var rk = rank(it, q, qq);
            if (rk === 9) continue;
            hits.push({ it: it, rk: rk });
          }
          hits.sort(function (a, b) { return a.rk - b.rk; });
          curList = hits.slice(0, 14).map(function (h) { return h.it; });

          // Поиск внутри уроков: если по названиям/полям мало результатов,
          // добавляем уроки, где запрос встречается в тексте истории/примеров
          // (от 3 символов, чтобы не заливать список общими словами).
          if (q.length >= 3) {
            if (!contentIdx.length && !contentDone) ensureContent();
            if (contentIdx.length) {
              var seen = {};
              for (var j = 0; j < curList.length; j++) seen[curList[j].href] = true;
              var qn = q.replace(/[’‘`´]/g, "'");
              var qn2 = qn.replace(/[ьъ]/g, ''); // мягкие русские окончания
              if (qn2.length < 2) qn2 = qn;
              // варианты запроса для поиска: как набран + транслитерация
              // кириллицы в латиницу (по-русски можно искать латинские имена)
              var qVars = [qn];
              if (qn2 !== qn) qVars.push(qn2);
              if (/[а-яё]/.test(q)) {
                var tv = translitVariants(qn);
                for (var ti = 0; ti < tv.length; ti++) {
                  if (tv[ti].length >= 3 && qVars.indexOf(tv[ti]) === -1) qVars.push(tv[ti]);
                }
              }
              var found = [];
              for (var ci = 0; ci < contentIdx.length; ci++) {
                var cx = contentIdx[ci];
                if (!cx || !cx.x || seen[cx.h]) continue;
                var at = -1;
                for (var vi = 0; vi < qVars.length && at === -1; vi++) {
                  at = cx.x.indexOf(qVars[vi]);
                }
                if (at === -1) continue;
                var meta = contentMeta[cx.h];
                if (!meta) continue;
                found.push({ href: cx.h, title: meta.title, lvl: meta.lvl || cx.lvl, sub: snippet(cx.x, at), at: at });
              }
              found.sort(function (a, b) { return a.at - b.at; });
              var room = 14 - curList.length;
              for (var fi = 0; fi < found.length && fi < 8 && room > 0; fi++, room--) {
                curList.push({ t: 'g', lvl: found[fi].lvl, title: found[fi].title, sub: found[fi].sub, href: found[fi].href });
              }
            }
          }

          var html = '';
          var lastGroup = '';
          for (var k = 0; k < curList.length; k++) {
            var r = curList[k];
            var g = GROUP[r.t];
            if (g && g.label !== lastGroup) {
              lastGroup = g.label;
              html += '<div class="hs-group">' + esc(g.label) + '</div>';
            }
            var subTxt = r.sub || (r.d || '');
            if (r.t === 'g' && r.sub && r.d) subTxt = r.sub + ' · ' + r.d;
            html +=
              '<a class="hs-item" role="option" href="' + esc(r.href) + '" data-i="' + k + '">' +
              '<span class="hs-tag ' + g.cls + '">' + esc(r.t === 'g' ? 'урок' : r.t === 'n' ? 'заметка' : 'слова') + '</span>' +
              '<span class="hs-body">' +
              '<span class="hs-title">' + esc(r.title) + (r.lvl ? ' <em class="hs-lvl">' + esc(r.lvl) + '</em>' : '') + '</span>' +
              '<span class="hs-sub">' + esc(subTxt) + '</span>' +
              '</span>' +
              '</a>';
          }
          if (!curList.length) {
            html = '<div class="hs-empty">Ничего не нашлось по «' + esc(input.value.trim()) + '»</div>';
          }
          drop.innerHTML = html;
          drop.hidden = false;
          cur = -1;
        };

        var mark = function () {
          var rows = drop.querySelectorAll('.hs-item');
          rows.forEach(function (el, i) { el.classList.toggle('is-cur', i === cur); });
        };

        // Фрагмент текста урока вокруг первого вхождения запроса
        var snippet = function (x, at) {
          var L = 46, R = 100;
          var from = at - L, to = at + R;
          if (from < 0) from = 0;
          if (to > x.length) to = x.length;
          var pre = from > 0 ? x.indexOf(' ', from) + 1 : 0;
          if (pre <= 0) pre = from;
          var post = to < x.length ? x.lastIndexOf(' ', to) : to;
          if (post <= pre) post = to;
          var cutL = pre > 0;
          var cutR = post < x.length;
          return (cutL ? '… ' : '') + x.slice(pre, post).trim() + (cutR ? ' …' : '');
        };

        // заголовки уроков для контентных совпадений берём из основного индекса
        var fillMeta = function () {
          contentMeta = {};
          for (var mi = 0; mi < items.length; mi++) {
            var mit = items[mi];
            if (mit.t === 'g' && mit.href) contentMeta[mit.href] = mit;
          }
        };

        // ленивая загрузка контентного индекса (один раз, дальше — кэш)
        var ensureContent = function () {
          if (contentPromise) return contentPromise;
          contentDone = true;
          var cached = null;
          try { cached = localStorage.getItem(contentKey); } catch (e) {}
          if (cached) {
            try {
              contentIdx = (JSON.parse(cached).items) || [];
              fillMeta();
              contentPromise = Promise.resolve();
              return contentPromise;
            } catch (e) { contentIdx = []; }
          }
          contentPromise = fetch('/search-content.json')
            .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
            .then(function (data) {
              contentIdx = (data && data.items) || [];
              fillMeta();
              try { localStorage.setItem(contentKey, JSON.stringify(data)); } catch (e) {}
            })
            .catch(function () { contentIdx = []; });
          return contentPromise;
        };

        input.addEventListener('input', function () {
          render();
          if (qLen() >= 3 && !contentIdx.length) {
            ensureContent().then(function () { if (qLen() >= 3) render(); });
          }
        });
        input.addEventListener('focus', render);
        var qLen = function () { return input.value.trim().length; };

        input.addEventListener('keydown', function (e) {
          if (drop.hidden) return;
          var rows = drop.querySelectorAll('.hs-item');
          if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
            e.preventDefault();
            var dir = e.key === 'ArrowDown' ? 1 : -1;
            cur = rows.length ? (cur + dir + rows.length) % rows.length : -1;
            mark();
            if (cur >= 0) {
              var act = rows[cur];
              if (act.scrollIntoView) act.scrollIntoView({ block: 'nearest' });
            }
          } else if (e.key === 'Enter') {
            var target = rows[cur] || rows[0];
            if (target) { e.preventDefault(); location.href = target.getAttribute('href'); }
          } else if (e.key === 'Escape') {
            drop.hidden = true;
            input.blur();
          }
        });

        // выбор из выпадающего списка мышью/тачем
        drop.addEventListener('pointerdown', function (e) {
          var row = e.target.closest('.hs-item');
          if (!row) return;
          e.preventDefault(); // не даём полю потерять фокус до навигации
          location.href = row.getAttribute('href');
        });

        document.addEventListener('pointerdown', function (e) {
          if (!root.contains(e.target)) { drop.hidden = true; }
        });

        var load = fetch('/search.json')
          .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
          .then(function (data) { items = (data && data.items) || []; fillMeta(); })
          .catch(function () { items = []; });
        if (input.value) render();
      })();
    </script>
  </body>
</html>

