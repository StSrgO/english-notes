---
export interface Props { title?: string; currentSlug?: string; }
const { title = 'EnglishNotes', currentSlug = '' } = Astro.props;

const modules = import.meta.glob('../data/grammar/*.json', { eager: true, import: 'default' });
const topics = Object.values(modules).sort((a, b) => String(a.slug).localeCompare(String(b.slug)));
const total = topics.length;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23bfe6c6'/%3E%3Cg fill='%23123430'%3E%3Cpath d='M16 3l2.4 4.2h-4.8z'/%3E%3Crect x='13.4' y='7.5' width='5.2' height='2'/%3E%3Crect x='12.6' y='9.8' width='6.8' height='6'/%3E%3Crect x='13' y='16.1' width='6' height='3.2'/%3E%3Crect x='12.3' y='19.6' width='7.4' height='8.8'/%3E%3Crect x='11.2' y='28.6' width='9.6' height='2.2'/%3E%3C/g%3E%3Cg fill='%23bfe6c6'%3E%3Ccircle cx='16' cy='12.8' r='2.1'/%3E%3Crect x='14' y='16.6' width='1' height='2.2'/%3E%3Crect x='15.5' y='16.6' width='1' height='2.2'/%3E%3Crect x='17' y='16.6' width='1' height='2.2'/%3E%3C/g%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Onest:wght@400;600;800;900&family=Manrope:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body data-topics-total={total} data-current-slug={currentSlug}>
        <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <defs>
        <filter id="sketch-rough" x="-20%" y="-20%" width="140%" height="140%">
          <feTurbulence type="fractalNoise" baseFrequency="0.018 0.024" numOctaves="2" seed="7" result="noise"/>
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="1.2" xChannelSelector="R" yChannelSelector="G"/>
        </filter>
      </defs>
    </svg>
    <header class="site-head">
      <div class="wrap site-head__inner">
        <a href="/" class="brand"><span class="brand__word">English<b>Notes</b></span></a>
        <details class="nav-toggle">
          <summary>Меню</summary>
          <nav class="nav">
            <a href="/">Главная</a>
            <a href="/grammar">Грамматика</a>
            <a href="/grammar" class="is-soon">Слова · скоро</a>
            <a href="/grammar" class="is-soon">Прогресс · скоро</a>
          </nav>
        </details>
        <nav class="nav nav--desktop">
          <a href="/">Главная</a>
          <a href="/grammar">Грамматика</a>
          <a href="/grammar" class="is-soon">Слова · скоро</a>
          <a href="/grammar" class="is-soon">Прогресс · скоро</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap site-foot__inner">
        <span><span class="brand__word">English<b>Notes</b></span> — учи, повторяй, не забивай!</span>
        <span class="muted">MVP · грамматика по уровням CEFR</span>
      </div>
    </footer>

    <script>
      const STORE = 'englishnotes.progress.v1';
      const read = () => { try { return JSON.parse(localStorage.getItem(STORE) || '{}'); } catch { return {}; } };
      const write = (d) => localStorage.setItem(STORE, JSON.stringify(d));
      const load = () => { const d = read(); return { completed: new Set(d.completed || []), favorites: new Set(d.favorites || []) }; };
      const save = (s) => { write({ completed: [...s.completed], favorites: [...s.favorites] }); document.dispatchEvent(new CustomEvent('progress:change', { detail: s })); };
      const total = parseInt(document.body.dataset.topicsTotal || '0', 10);
      const cur = document.body.dataset.currentSlug || '';

      function paintButtons(slug, s) {
        document.querySelectorAll('[data-action][data-slug="' + slug + '"]').forEach((b) => {
          const set = b.dataset.action === 'favorite' ? s.favorites : s.completed;
          const on = set.has(slug);
          b.classList.toggle('is-on', on);
          b.setAttribute('aria-pressed', String(on));
        });
      }

      let state = load();
      document.querySelectorAll('[data-action]').forEach((b) => {
        b.addEventListener('click', () => {
          const slug = b.dataset.slug;
          state = load();
          const set = b.dataset.action === 'favorite' ? state.favorites : state.completed;
          set.has(slug) ? set.delete(slug) : set.add(slug);
          save(state);
          paintButtons(slug, state);
        });
      });
      if (cur) paintButtons(cur, state);

      // level navigation: smooth scroll + scroll-spy (catalog only)
      const levelLinks = Array.from(document.querySelectorAll('[data-level-link]'));
      if (levelLinks.length) {
        const blocks = Array.from(document.querySelectorAll('[data-level-block]'));
        const firstBlock = blocks[0];
        const setActive = (lvl) => {
          levelLinks.forEach((a) => a.classList.toggle('is-active', a.dataset.level === lvl));
        };
        let ignoreSpy = false;
        levelLinks.forEach((a) => {
          a.addEventListener('click', (e) => {
            e.preventDefault();
            const lvl = a.dataset.level;
            ignoreSpy = true;
            setActive(lvl);
            if (lvl === 'all') {
              window.scrollTo({ top: 0, behavior: 'smooth' });
              history.replaceState(null, '', location.pathname);
            } else {
              const t = document.getElementById(lvl);
              if (t) {
                const y = t.getBoundingClientRect().top + window.scrollY - 92;
                window.scrollTo({ top: y, behavior: 'smooth' });
                history.replaceState(null, '', '#' + lvl);
              }
            }
            setTimeout(() => { ignoreSpy = false; }, 700);
          });
        });
        const spy = new IntersectionObserver((entries) => {
          if (ignoreSpy) return;
          entries.forEach((en) => {
            if (en.isIntersecting && en.target.id) {
              setActive(en.target.id);
              history.replaceState(null, '', '#' + en.target.id);
            }
          });
        }, { rootMargin: '-20% 0px -70% 0px', threshold: 0 });
        blocks.forEach((b) => spy.observe(b));
        let ticking = false;
        window.addEventListener('scroll', () => {
          if (ignoreSpy || ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            ticking = false;
            if (firstBlock && firstBlock.getBoundingClientRect().top > 200) {
              setActive('all');
              history.replaceState(null, '', location.pathname);
            }
          });
        }, { passive: true });
        const initHash = location.hash.replace('#', '');
        setActive(initHash && document.getElementById(initHash) ? initHash : 'all');
      }

      // scroll reveal
      const io = new IntersectionObserver((entries) => {
        entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
      }, { threshold: 0.12 });
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>