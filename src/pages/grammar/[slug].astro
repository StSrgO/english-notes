---
import Base from '../../layouts/Base.astro';
import Quiz from '../../components/Quiz.astro';
import quizBank from '../../data/quiz-bank.json';

export function getStaticPaths() {
  const modules = import.meta.glob('../../data/grammar/*.json', { eager: true, import: 'default' });
  const topics = Object.values(modules).sort((a, b) => String(a.slug).localeCompare(String(b.slug)));
  return topics.map((t) => ({ params: { slug: t.slug }, props: { topic: t, topics } }));
}

const { topic, topics } = Astro.props;

function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
function highlight(text, tokens) {
  let out = esc(text);
  (tokens || []).forEach((t) => { out = out.replace(esc(t), '<mark class="hl">' + esc(t) + '</mark>'); });
  return out;
}

const related = topics.filter((t) => topic.related && topic.related.includes(t.slug));

const levelTopics = topics.filter((t) => t.level === topic.level);
const levelIdx = levelTopics.findIndex((t) => t.slug === topic.slug);
const nextTopic = (levelIdx >= 0 && levelIdx < levelTopics.length - 1) ? levelTopics[levelIdx + 1] : null;
const prevTopic = (levelIdx > 0) ? levelTopics[levelIdx - 1] : null;
---
<Base title={topic.title + ' — EnglishNotes'} currentSlug={topic.slug}>
  <div class="wrap topic topic--v2">
    <aside class="side side--v3">
      <div class="side3__pager">
        {prevTopic ? (
          <a href={'/grammar/' + prevTopic.slug} class="side3__pg side3__pg--prev">
            <span class="side3__pg-eye">← предыдущий урок</span>
            <span class="side3__pg-t">{prevTopic.title}</span>
          </a>
        ) : (
          <a href={'/grammar#' + topic.level} class="side3__pg side3__pg--prev">
            <span class="side3__pg-eye">← к уровню</span>
            <span class="side3__pg-t">Все темы {topic.level}</span>
          </a>
        )}
        {nextTopic ? (
          <a href={'/grammar/' + nextTopic.slug} class="side3__pg side3__pg--next">
            <span class="side3__pg-eye">следующий урок →</span>
            <span class="side3__pg-t">{nextTopic.title}</span>
          </a>
        ) : (
          <a href={'/grammar#' + topic.level} class="side3__pg side3__pg--next">
            <span class="side3__pg-eye">уровень завершён →</span>
            <span class="side3__pg-t">Все темы {topic.level}</span>
          </a>
        )}
      </div>
      <nav class="side3__nav" aria-label="Секции урока">
        <a href="#idea" class="side3__link" data-spy="idea">Суть явления</a>
        <a href="#why" class="side3__link" data-spy="why">Зачем это нужно</a>
        <a href="#context" class="side3__link" data-spy="context">Живой контекст</a>
        <a href="#russian" class="side3__link" data-spy="russian">Через русский</a>
        <a href="#learn" class="side3__link" data-spy="learn">Как освоить</a>
        <a href="#reference" class="side3__link" data-spy="reference">Справочник</a>
        <a href="#quiz" class="side3__link" data-spy="quiz">Проверь себя</a>
        {related.length > 0 && <a href="#related" class="side3__link" data-spy="related">Связанные темы</a>}
      </nav>
    </aside>

    <article class="lesson-v2">
      <header class="lv2-head">
        <p class="eyebrow">{topic.category} · уровень {topic.level}</p>
        <h1 class="lv2-title"><span class="hl-mark">{topic.title}</span></h1>
        <div class="topic__meta">
          <span class="tag tag--lvl">Уровень {topic.level}</span>
          <span class="tag">≈ {topic.readingTime} мин</span>
        </div>
        <p class="lv2-summary">{topic.summary}</p>
        <div class="topic__actions">
          <button class="btn btn--ghost" data-action="complete" data-slug={topic.slug} aria-pressed="false">Отметить изученным</button>
          <button class="btn btn--ghost" data-action="favorite" data-slug={topic.slug} aria-pressed="false">В избранное</button>
        </div>
      </header>

      <section id="idea" class="lv2-sec" data-reveal>
        <h2 class="lv2-h">Суть явления</h2>
        <div class="lv2-prose lv2-prose--drop">
          {topic.idea.map((p) => <p>{p}</p>)}
        </div>
      </section>

      <section id="why" class="lv2-sec" data-reveal>
        <h2 class="lv2-h">Зачем это нужно</h2>
        <ul class="why-list--v2">
          {topic.why.map((w) => <li>{w}</li>)}
        </ul>
      </section>

      <section id="context" class="lv2-sec" data-reveal>
        <h2 class="lv2-h">Живой контекст</h2>
        <div class="dialog">
          {topic.context.lines.map((l) => (
            <div class="dialog__line">
              <div class="dialog__en">{l.en}</div>
              <div class="dialog__ru">{l.ru}</div>
            </div>
          ))}
          {topic.context.note && <p class="dialog__note">{topic.context.note}</p>}
        </div>
      </section>

      <section id="russian" class="lv2-sec lv2-sec--mint" data-reveal>
        <h2 class="lv2-h">Взгляд через русский</h2>
        <ul class="ru-list--v2">
          {topic.russianAngle.map((r) => <li>{r}</li>)}
        </ul>
      </section>

      <section id="learn" class="lv2-sec" data-reveal>
        <h2 class="lv2-h">Как освоить</h2>
        <ol class="howto">
          {topic.howToLearn.steps.map((s) => <li>{s}</li>)}
        </ol>
        {topic.howToLearn.exercise && (
          <div class="try">
            {topic.howToLearn.exercise.prompt && <p class="try__prompt">{topic.howToLearn.exercise.prompt}</p>}
            <ol class="try__q">
              {topic.howToLearn.exercise.items.map((it) => <li set:html={highlight(it.q, [])}></li>)}
            </ol>
            <details class="try__a">
              <summary>Показать ответы</summary>
              <ol>
                {topic.howToLearn.exercise.items.map((it) => <li>{it.a}</li>)}
              </ol>
            </details>
          </div>
        )}
      </section>

      <section id="reference" class="lv2-sec" data-reveal>
        <h2 class="lv2-h">Справочник</h2>
        <div class="lv2-formula">{topic.formula}</div>
        <div class="lv2-struct">
          <div class="lv2-struct__row"><span class="lv2-struct__k">+</span><span>{topic.structure.positive}</span></div>
          <div class="lv2-struct__row"><span class="lv2-struct__k">−</span><span>{topic.structure.negative}</span></div>
          <div class="lv2-struct__row"><span class="lv2-struct__k">?</span><span>{topic.structure.question}</span></div>
        </div>
        {topic.markers && topic.markers.length > 0 && (
          <div class="lv2-markers">
            {topic.markers.map((m) => <span class="tag">{m}</span>)}
          </div>
        )}

        <h3 class="lv2-h3">Когда используется</h3>
        <ul class="use-list--v2">
          {topic.uses.map((u) => <li>{u}</li>)}
        </ul>

        <h3 class="lv2-h3">Правила и нюансы</h3>
        <ul class="lv2-rules">
          {topic.rules.map((r) => <li><b>{r.title}.</b> {r.text}</li>)}
        </ul>

        <h3 class="lv2-h3">Примеры по ситуациям</h3>
        {topic.examples.map((g) => (
          <div class="lv2-exgroup">
            <h4 class="lv2-exgroup__t">{g.group}</h4>
            <div>
              {g.items.map((ex) => (
                <div class="lv2-ex">
                  <div class="en" set:html={highlight(ex.en, ex.highlight)}></div>
                  <div class="ru">{ex.ru}</div>
                </div>
              ))}
            </div>
          </div>
        ))}

        {topic.mistakes && topic.mistakes.length > 0 && (
          <div>
            <h3 class="lv2-h3">Типичные ошибки</h3>
            <div class="lv2-mistakes">
              <table>
                <thead><tr><th>Так не говорят</th><th>Так говорят</th></tr></thead>
                <tbody>
                  {topic.mistakes.map((m) => (
                    <tr>
                      <td><span class="w">✗ {m.wrong}</span><span class="n">{m.note}</span></td>
                      <td class="r">✓ {m.right}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}

        {topic.compare && (
          <div class="compare">
            <h3 class="lv2-h3">{topic.compare.title}</h3>
            <table>
              <thead><tr><th>{topic.compare.leftLabel}</th><th>{topic.compare.rightLabel}</th></tr></thead>
              <tbody>
                {topic.compare.rows.map((r) => <tr><td>{r.left}</td><td>{r.right}</td></tr>)}
              </tbody>
            </table>
          </div>
        )}

        {topic.tips && topic.tips.length > 0 && (
          <div>
            <h3 class="lv2-h3">Лайфхаки преподавателя</h3>
            <ul class="lv2-tips">
              {topic.tips.map((t) => <li>{t}</li>)}
            </ul>
          </div>
        )}
      </section>

      {topic.quiz && topic.quiz.length > 0 && (
        <section id="quiz" class="lv2-sec" data-reveal>
          <Quiz questions={topic.quiz} ui={quizBank.__ui} />
        </section>
      )}

      {related.length > 0 && (
        <section id="related" class="lv2-sec">
          <h2 class="lv2-h">Связанные темы</h2>
          <div class="related">
            {related.map((r) => <a href={'/grammar/' + r.slug} class="chip">{r.title}</a>)}
          </div>
        </section>
      )}

      {quizBank.__ui && quizBank.__ui.morePracticeLead && (
        <div class="practice" data-reveal>
          <p class="practice__eye">{quizBank.__ui.morePractice}</p>
          <h3 class="practice__t">{quizBank.__ui.morePracticeLead}</h3>
          {quizBank.__ui.morePracticeText && <p class="practice__text">{quizBank.__ui.morePracticeText}</p>}
          {quizBank.__ui.morePracticeHref && (
            <a class="btn btn--coral practice__cta" href={quizBank.__ui.morePracticeHref} target="_blank" rel="noopener noreferrer">{quizBank.__ui.morePracticeCta} <span aria-hidden="true">&#8599;</span></a>
          )}
          {quizBank.__ui.morePracticeMore && quizBank.__ui.morePracticeMore.length > 0 && (
            <p class="practice__also">
              {quizBank.__ui.morePracticeAlsoLabel}{' '}
              {quizBank.__ui.morePracticeMore.map((m, i) => (
                <>{i > 0 && <span class="practice__sep">&#183;</span>}<a href={m.href} target="_blank" rel="noopener noreferrer">{m.label}</a></>
              ))}
            </p>
          )}
        </div>
      )}
    </article>
  </div>

  <script>
    const links = Array.from(document.querySelectorAll('.side3__link'));
    if (links.length) {
      const secs = links.map((l) => document.getElementById(l.dataset.spy)).filter(Boolean);
      const setActive = (id) => links.forEach((l) => l.classList.toggle('is-active', l.dataset.spy === id));
      const spy = new IntersectionObserver((entries) => {
        entries.forEach((en) => { if (en.isIntersecting) setActive(en.target.id); });
      }, { rootMargin: '-20% 0px -70% 0px', threshold: 0 });
      secs.forEach((s) => spy.observe(s));
      setActive('idea');
    }
  </script>
</Base>