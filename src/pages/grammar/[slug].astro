---
import Base from '../../layouts/Base.astro';
import LessonBody from '../../components/LessonBody.astro';
import quizBank from '../../data/quiz-bank.json';

export function getStaticPaths() {
  const modules = import.meta.glob(['../../data/grammar/*.json', '!../../data/grammar/*.rocknroll.json'], { eager: true, import: 'default' });
  const topics = Object.values(modules).sort((a, b) => String(a.slug).localeCompare(String(b.slug)));
  return topics.map((t) => ({ params: { slug: t.slug }, props: { topic: t, topics } }));
}

const { topic, topics } = Astro.props;

const rockModules = import.meta.glob('../../data/grammar/*.rocknroll.json', { eager: true, import: 'default' });
const rocknrollTopic = Object.values(rockModules).find((m) => m.slug === topic.slug) || null;

const related = topics.filter((t) => topic.related && topic.related.includes(t.slug));

const levelTopics = topics.filter((t) => t.level === topic.level);
const levelIdx = levelTopics.findIndex((t) => t.slug === topic.slug);
const nextTopic = (levelIdx >= 0 && levelIdx < levelTopics.length - 1) ? levelTopics[levelIdx + 1] : null;
const prevTopic = (levelIdx > 0) ? levelTopics[levelIdx - 1] : null;
---
<Base title={topic.title + ' — EnglishNotes'} currentSlug={topic.slug}>
  <div class="wrap topic topic--v2">
    <nav class="lesson-bar">
      <a href="/grammar" class="bar-item" data-back>← назад</a>
      {rocknrollTopic && (
        <>
          <button type="button" class="bar-item style-pick" data-style-label="classic">Классика</button>
          <button type="button" class="bar-item style-pick" data-style-label="rocknroll">Рок-н-ролл</button>
        </>
      )}
      <button class="act-link" data-action="complete" data-slug={topic.slug} aria-pressed="false">Отметить изученным</button>
      <button class="act-link" data-action="favorite" data-slug={topic.slug} aria-pressed="false">В избранное</button>
      {nextTopic ? (
        <a href={'/grammar/' + nextTopic.slug} class="bar-item">следующий урок →</a>
      ) : (
        <a href={'/grammar#' + topic.level} class="bar-item">уровень завершён →</a>
      )}
    </nav>
    <aside class="side side--v3">
    <nav class="side3__nav" aria-label="Секции урока">      <a href="#idea" class="side3__link" data-spy="idea">Суть явления</a>
        <a href="#why" class="side3__link" data-spy="why">Зачем это нужно</a>
        <a href="#context" class="side3__link" data-spy="context">Живой контекст</a>
        <a href="#russian" class="side3__link" data-spy="russian">Через русский</a>
        <a href="#learn" class="side3__link" data-spy="learn">Как освоить</a>
        <a href="#reference" class="side3__link" data-spy="reference">Справочник</a>
        <a href="#quiz" class="side3__link" data-spy="quiz">Проверь себя</a>
        {related.length > 0 && <a href="#related" class="side3__link" data-spy="related">Связанные темы</a>}
      </nav>
    </aside>

    <article class="lesson-v2" data-lesson-style="classic">
      <header class="lv2-head">
        <p class="eyebrow">{topic.category} · уровень {topic.level}</p>
        <h1 class="lv2-title"><span class="hl-mark">{topic.title}</span></h1>
        <div class="topic__meta">
          <span class="tag tag--lvl">Уровень {topic.level}</span>
          <span class="tag">≈ {topic.readingTime} мин</span>
        </div>
        <p class="lv2-summary" data-style-pane="classic">{topic.summary}</p>
        {rocknrollTopic && (
          <p class="lv2-summary" data-style-pane="rocknroll">{rocknrollTopic.summary}</p>
        )}
</header>

      <div data-style-pane="classic">
        <LessonBody T={topic} suffix="" related={related} quizUi={quizBank.__ui} />
      </div>
      {rocknrollTopic && (
        <div data-style-pane="rocknroll">
          <LessonBody T={rocknrollTopic} suffix="-r" related={related} quizUi={quizBank.__ui} />
        </div>
      )}

      {quizBank.__ui && quizBank.__ui.morePracticeLead && (
        <div class="practice" data-reveal>
          <p class="practice__eye">{quizBank.__ui.morePractice}</p>
          <h3 class="practice__t">{quizBank.__ui.morePracticeLead}</h3>
          {quizBank.__ui.morePracticeText && <p class="practice__text">{quizBank.__ui.morePracticeText}</p>}
          {quizBank.__ui.morePracticeHref && (
            <a class="btn btn--coral practice__cta" href={quizBank.__ui.morePracticeHref} target="_blank" rel="noopener noreferrer">{quizBank.__ui.morePracticeCta} <span aria-hidden="true">&#8599;</span></a>
          )}
          {quizBank.__ui.morePracticeMore && quizBank.__ui.morePracticeMore.length > 0 && (
            <p class="practice__also">
              {quizBank.__ui.morePracticeAlsoLabel}{' '}
              {quizBank.__ui.morePracticeMore.map((m, i) => (
                <>{i > 0 && <span class="practice__sep">&#183;</span>}<a href={m.href} target="_blank" rel="noopener noreferrer">{m.label}</a></>
              ))}
            </p>
          )}
        </div>
      )}
        </article>
  </div>

  <script>
    document.querySelectorAll('[data-back]').forEach((a) => a.addEventListener('click', (e) => {
      e.preventDefault();
      if (history.length > 1) { history.back(); } else { location.href = '/grammar'; }
    }));
    const links = Array.from(document.querySelectorAll('.side3__link'));
    let spyObs = null;
    function initSpy(suffix) {
      if (spyObs) { spyObs.disconnect(); spyObs = null; }
      if (!links.length) { return; }
      const secs = links.map((l) => document.getElementById(l.dataset.spy + suffix)).filter(Boolean);
      const setActive = (base) => links.forEach((l) => l.classList.toggle('is-active', l.dataset.spy === base));
      spyObs = new IntersectionObserver((entries) => {
        entries.forEach((en) => { if (en.isIntersecting) { setActive(en.target.getAttribute('data-spybase')); } });
      }, { rootMargin: '-20% 0px -70% 0px', threshold: 0 });
      secs.forEach((sec) => spyObs.observe(sec));
      setActive('idea');
    }

    const switchTrack = document.querySelector('[data-style-switch]');
    const switchLabels = document.querySelectorAll('[data-style-label]');
    const lessonArticle = document.querySelector('[data-lesson-style]');
    const STYLE_KEY = 'englishnotes.style.v1';

    if (lessonArticle) {
      const applyStyle = (style) => {
        lessonArticle.setAttribute('data-lesson-style', style);
        const isRock = style === 'rocknroll';
        if (switchTrack) switchTrack.classList.toggle('is-rock', isRock);
        if (switchTrack) switchTrack.setAttribute('aria-checked', String(isRock));
        switchLabels.forEach((lb) => lb.classList.toggle('is-active', lb.dataset.styleLabel === style));
        const suffix = isRock ? '-r' : '';
        links.forEach((l) => { l.setAttribute('href', '#' + l.dataset.spy + suffix); });
        initSpy(suffix);
        try { localStorage.setItem(STYLE_KEY, style); } catch (e) {}
      };
      let saved = 'classic';
      try { saved = localStorage.getItem(STYLE_KEY) || 'classic'; } catch (e) {}
      if (saved !== 'rocknroll') { saved = 'classic'; }
      applyStyle(saved);
      if (saved === 'rocknroll') { document.body.classList.add('is-rock'); }
      if (switchTrack) switchTrack.addEventListener('click', () => {
        const now = lessonArticle.getAttribute('data-lesson-style');
        const newStyle = now === 'rocknroll' ? 'classic' : 'rocknroll';
        applyStyle(newStyle);
        document.body.classList.toggle('is-rock', newStyle === 'rocknroll');
      });
      switchLabels.forEach((lb) => lb.addEventListener('click', () => applyStyle(lb.dataset.styleLabel)));
    } else {
      initSpy('');
    }
  </script>
</Base>