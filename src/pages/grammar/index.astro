---
import Base from '../../layouts/Base.astro';
import { LEVEL_ORDER, LEVELS } from '../../data/lesson-order.js';

// Функция сортировки по уровню и порядку
function sortLessons(a, b) {
  const levelA = a.level || '';
  const levelB = b.level || '';
  const levels = ['A0', 'A1', 'A2', 'B1', 'B2', 'C1', 'C2'];
  
  if (levelA !== levelB) {
    return levels.indexOf(levelA) - levels.indexOf(levelB);
  }
  
  const order = LEVEL_ORDER[levelA] || [];
  const indexA = order.indexOf(a.slug);
  const indexB = order.indexOf(b.slug);
  
  if (indexA !== -1 && indexB !== -1) {
    return indexA - indexB;
  }
  
  return a.slug.localeCompare(b.slug);
}

const modules = import.meta.glob(
  ['../../data/grammar/*.json', '!../../data/grammar/*.rocknroll.json'],
  { eager: true, import: 'default' }
);

const topics = Object.values(modules).sort(sortLessons);
const byLevel = (lvl) => topics.filter((t) => t.level === lvl);
const usedLevels = LEVELS.filter((lvl) => byLevel(lvl).length > 0);
---

<Base title="Грамматика по уровням — EnglishNotes">
  <section class="section wrap">
    <div class="catalog">
      <aside class="catalog__nav" aria-label="Уровни">
        <span class="catalog__nav-t">Уровни</span>
        <a href="#top" class="level-link is-active" data-level-link data-level="all">
          <span>Все</span>
          <span class="level-link__n">{topics.length}</span>
        </a>
        {usedLevels.map((lvl) => (
          <a href={'#' + lvl} class="level-link" data-level-link data-level={lvl}>
            <span class="level-link__lvl">{lvl}</span>
            <span class="level-link__n">{byLevel(lvl).length}</span>
          </a>
        ))}
      </aside>

      <div class="catalog__body" id="top">
        <div class="section__head" data-reveal>
          <div>
            <p class="eyebrow">grammar · CEFR</p>
            <h2>Грамматика по уровням</h2>
          </div>
        </div>

        {usedLevels.map((lvl) => {
          const list = byLevel(lvl);
          return (
            <div class="level-block" id={lvl} data-level-block data-reveal>
              <div class="level-block__title">{lvl} <small>{list.length} тем</small></div>
              <div class="topic-grid">
                {list.map((t) => (
                  <a href={'/grammar/' + t.slug} class="topic-card">
                    <div class="meta">
                      <span class="tag tag--lvl">{t.level}</span>
                      <span class="tag">{t.category}</span>
                    </div>
                    <h3>{t.title}</h3>
                    <p class="muted" style="font-size:14px;margin:0">{t.summary}</p>
                    <span class="muted" style="font-size:13px;margin-top:auto">≈ {t.readingTime} мин · читать →</span>
                  </a>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
</Base>