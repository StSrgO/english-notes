---
import Base from '../../layouts/Base.astro';
import { LEVEL_ORDER, LEVELS } from '../../data/lesson-order.js';

// Функция сортировки по уровню и порядку
function sortLessons(a, b) {
  const levelA = a.level || '';
  const levelB = b.level || '';
  const levels = ['A0', 'A1', 'A2', 'B1', 'B2', 'C1', 'C2'];
  
  if (levelA !== levelB) {
    return levels.indexOf(levelA) - levels.indexOf(levelB);
  }
  
  const order = LEVEL_ORDER[levelA] || [];
  const indexA = order.indexOf(a.slug);
  const indexB = order.indexOf(b.slug);
  
  if (indexA !== -1 && indexB !== -1) {
    return indexA - indexB;
  }
  
  return a.slug.localeCompare(b.slug);
}

const modules = import.meta.glob(
  ['../../data/grammar/*.json', '!../../data/grammar/*.rocknroll.json'],
  { eager: true, import: 'default' }
);

const topics = Object.values(modules).sort(sortLessons);
const byLevel = (lvl) => topics.filter((t) => t.level === lvl);
const usedLevels = LEVELS.filter((lvl) => byLevel(lvl).length > 0);

// Краткие описания уровней: что это за уровень и итоговые навыки.
// from — предыдущий уровень (для преемственности «всё, что для X, плюс»);
// items — что нужно уметь/знать на этом уровне помимо грамматики.
const levelMeta = {
  A0: {
    desc: "Старт с нуля: точка входа, где вместо грамматики — буквы, звуки и первые слова. Вы знакомитесь с алфавитом, учитесь читать транскрипцию и произносить английские звуки, которых нет в русском языке. Правила на этом этапе почти не нужны: работа идёт с готовыми фразами и отдельными словами, а не с конструкциями. Первые реплики — приветствие, знакомство, короткий рассказ о себе, о семье и о доме. Словарь первых недель — около двухсот слов: семья, дом, цвета, числа и простые предметы вокруг. К концу уровня вы понимаете, как слова устроены на слух и на письме, можете поздороваться, представиться и ответить на простые вопросы о себе.",
    from: null,
    items: [
      "Темы для разговора: знакомство, приветствия, семья и дом, простые предметы вокруг.",
      "Словарный запас: первые ~200 слов — семья, дом, цвета.",
      "Речь: короткие приветствия и ответы на простые вопросы о себе.",
      "Произношение: алфавит, базовые звуки и чтение транскрипции."
    ]
  },
  A1: {
    desc: "Базовый уровень, на котором появляется связная простая речь вместо отдельных слов. Ядро грамматики — глагол to be, Present Simple и начало Past Simple: вы описываете себя, привычные действия и события, которые уже случились. Вы учитесь строить утверждения, отрицания и вопросы и отвечать на них, не заучивая каждую фразу целиком. Словарь вырастает до 500–700 слов, и этого хватает на рассказ о себе, распорядке дня, еде и одежде. В медленной и чёткой речи вы улавливаете суть и можете поддержать короткий бытовой диалог: познакомиться, заказать, спросить дорогу или цену. Граница уровня — простые времена по отдельности: подробный рассказ о прошлом пока естественнее вести короткими предложениями.",
    from: "A0",
    items: [
      "Темы: рассказ о себе и семье, распорядок дня, еда и одежда, числа и время.",
      "Словарный запас: ~500–700 слов — повседневные действия, предметы, прилагательные для описания.",
      "Речь: простые утверждения и вопросы о настоящем и прошлом, короткие диалоги.",
      "На слух: медленная чёткая речь, знакомые фразы и вопросы."
    ]
  },
  A2: {
    desc: "Уровень путешественника: вы уверенно решаете бытовые задачи в незнакомой обстановке. Грамматика добавляет Past Simple и будущее время: вы связно рассказываете о том, что было и что планируете, и сравниваете предметы и варианты. Появляются обороты для планов и намерений — going to и will, а также правила выбора предлогов места и времени. Словарь вырастает до 1200–1500 слов: путешествия, город, магазины, кафе и транспорт. Вы понимаете основные моменты объявлений, простых текстов и неспешных диалогов. Речь становится достаточной, чтобы без подготовки объясниться в типовой ситуации, а просьба о помощи, уточнение и переспрос перестают быть тупиком.",
    from: "A1",
    items: [
      "Темы: планы и будущее, поездки и город, сравнения, что происходит прямо сейчас.",
      "Словарный запас: ~1200–1500 слов — путешествия, магазины, предлоги места и времени.",
      "Речь: объясниться в кафе, гостинице и транспорте без подготовки; рассказать о прошлом и планах.",
      "На слух: основные моменты простых текстов, объявлений и неспешных диалогов."
    ]
  },
  B1: {
    desc: "Уровень самостоятельности: вы перестаёте переводить в уме каждое слово и говорите связно на знакомые темы. Грамматическое ядро — сочетание времён, условные предложения, модальные глаголы и способы передать чужую речь. Вы учитесь рассказывать истории с последовательностью событий, объяснять причины, выражать мнение и предположение. Словарь достигает примерно 2500 слов: неправильные глаголы начинают работать в живой речи, появляются связки и первые фразовые глаголы. На слух вы справляетесь с фильмами и подкастами в умеренном темпе и выделяете главное в несложных статьях. Речь становится достаточно гибкой для обсуждения знакомых тем и пересказа, хотя абстрактные вопросы пока требуют усилий.",
    from: "A2",
    items: [
      "Темы: мнения и их обоснование, истории из жизни, опыт и результаты, условные ситуации.",
      "Словарный запас: ~2500 слов — неправильные глаголы, связки, первые фразовые глаголы.",
      "Речь: связный рассказ, пересказ чужих слов, обсуждение знакомых тем; уверенность в поездках.",
      "На слух: фильмы и подкасты в умеренном темпе, основное в несложных статьях."
    ]
  },
  B2: {
    desc: "Уровень уверенного владения: вы говорите подробно и точно и справляетесь с неожиданными темами. Грамматика уходит от простых схем: в ход идут сложные конструкции, страдательный залог и придаточные разной степени вложенности. Вы выражаете сожаление, строите предположения о прошлом и передаёте чужие слова, сохраняя оттенки смысла. Словарь достигает 4000–5000 слов: вы различаете синонимы по оттенку и выбираете устойчивые связки под контекст. Вы понимаете живую речь носителей и фильмы без субтитров, а в дискуссии можете аргументировать позицию и возражать. Неожиданная тема перестаёт сбивать: вы перестраиваете фразу на ходу и уточняете мысль, если собеседник вас не понял.",
    from: "B1",
    items: [
      "Темы: абстрактные вопросы, дискуссии, сожаление и предположения о прошлом, придаточные.",
      "Словарный запас: ~4000–5000 слов — оттенки синонимов, устойчивые связки.",
      "Речь: подробные высказывания с аргументацией, естественный темп, неожиданные темы не сбивают.",
      "На слух: живая речь носителей, фильмы без опоры на субтитры, сложные статьи."
    ]
  },
  C1: {
    desc: "Уровень гибкости: язык перестаёт ограничивать мысль, и вы говорите почти без усилий. Акцент грамматики смещается на точность и выразительность: вы перестраиваете предложение, чтобы выделить главное, и используете инверсию для смыслового акцента. Вы различаете стилистические варианты и осознанно выбираете формальный или разговорный регистр. Словарь приближается к 8000 слов: идиомы, устойчивые сочетания и точные формулировки становятся рабочим инструментом. Вы понимаете сложные тексты и быструю речь носителей, включая подтекст и иронию. Длинные высказывания получают структуру: вы развиваете мысль, приводите аргументы и возвращаетесь к теме, не теряя нити.",
    from: "B2",
    items: [
      "Темы: любые знакомые и профессиональные; точные формулировки, фокус и инверсия.",
      "Словарный запас: ~8000 слов — идиомы, устойчивые сочетания, стилистические варианты.",
      "Речь: выразительная и почти без усилий; длинные высказывания со структурой и оттенками.",
      "На слух: сложные тексты, скрытый смысл, быстрая речь носителей."
    ]
  },
  C2: {
    desc: "Уровень мастерства: язык становится инструментом под задачу, а не предметом изучения. Вы свободно переключаетесь между стилями и регистрами — от деловой переписки до непринуждённой беседы. Грамматические тонкости больше не требуют сознательного внимания: сложные конструкции используются так же естественно, как простые. Словарный запас превышает 12 000 слов, включая редкие конструкции и осознанный выбор слова по оттенку смысла. Вы понимаете любые источники — от академических текстов до быстрой речи с иронией и подтекстом. На письме и в разговоре вы точно передаёте нюансы и способны говорить на сложные темы без подготовки, сохраняя естественность.",
    from: "C1",
    items: [
      "Темы: любые, включая специальные и академические; точная передача нюансов.",
      "Словарный запас: ~12000+ слов — редкие конструкции и осознанный выбор регистра.",
      "Речь: как у образованного носителя — свободно, идиоматично, без подготовки.",
      "На слух: любые источники, включая иронию, подтекст и стилистические игры."
    ]
  }
};
---

<Base title="Грамматика по уровням — EnglishNotes">
  <section class="section wrap">
    <div class="catalog">
      <aside class="catalog__nav" aria-label="Уровни">
        {usedLevels.map((lvl) => (
          <a href={'#' + lvl} class="level-link" data-level-link data-level={lvl}>
            <span class="level-link__lvl">{lvl}</span>
            <span class="level-link__n">{byLevel(lvl).length}</span>
          </a>
        ))}
      </aside>

      <div class="catalog__body" id="top">
        <div class="section__head" data-reveal>
          <div>
            <p class="eyebrow">grammar · CEFR</p>
            <h2>Грамматика по уровням</h2>
          </div>
        </div>

        {usedLevels.map((lvl) => {
          const list = byLevel(lvl);
          return (
            <div class="level-block" id={lvl} data-level-block data-reveal>
              <div class="level-block__title">{lvl} <small>{list.length} тем</small></div>
              {levelMeta[lvl] && (
                <div class="level-intro">
                  <p class="level-intro__desc">{levelMeta[lvl].desc}</p>
                  <p class="level-intro__more-t">что нужно уметь и знать</p>
                  <ul class="level-intro__more">
                    {levelMeta[lvl].from && (
                      <li class="level-intro__from">Всё, что для {levelMeta[lvl].from}, плюс:</li>
                    )}
                    {levelMeta[lvl].items.map((e) => (
                      <li>{e}</li>
                    ))}
                  </ul>
                </div>
              )}
              <div class="topic-grid">
                {list.map((t) => (
                  <a href={'/grammar/' + t.slug} class="topic-card">
                    <div class="meta">
                      <span class="tag tag--lvl">{t.level}</span>
                      <span class="tag">{t.category}</span>
                    </div>
                    <h3>{t.title}</h3>
                    <p class="muted" style="font-size:14px;margin:0">{t.summary}</p>
                    <span class="muted" style="font-size:13px;margin-top:auto">≈ {t.readingTime} мин · читать →</span>
                  </a>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
</Base>