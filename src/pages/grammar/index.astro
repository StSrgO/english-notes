---
import Base from '../../layouts/Base.astro';
import { LEVEL_ORDER, LEVELS } from '../../data/lesson-order.js';

// Функция сортировки по уровню и порядку
function sortLessons(a, b) {
  const levelA = a.level || '';
  const levelB = b.level || '';
  const levels = ['A0', 'A1', 'A2', 'B1', 'B2', 'C1', 'C2'];
  
  if (levelA !== levelB) {
    return levels.indexOf(levelA) - levels.indexOf(levelB);
  }
  
  const order = LEVEL_ORDER[levelA] || [];
  const indexA = order.indexOf(a.slug);
  const indexB = order.indexOf(b.slug);
  
  if (indexA !== -1 && indexB !== -1) {
    return indexA - indexB;
  }
  
  return a.slug.localeCompare(b.slug);
}

const modules = import.meta.glob(
  ['../../data/grammar/*.json', '!../../data/grammar/*.rocknroll.json'],
  { eager: true, import: 'default' }
);

const topics = Object.values(modules).sort(sortLessons);
const byLevel = (lvl) => topics.filter((t) => t.level === lvl);
const usedLevels = LEVELS.filter((lvl) => byLevel(lvl).length > 0);

// Краткие описания уровней: что это за уровень и итоговые навыки.
// from — предыдущий уровень (для преемственности «всё, что для X, плюс»);
// items — что нужно уметь/знать на этом уровне помимо грамматики.
const levelMeta = {
  A0: {
    desc: "Старт с нуля: знакомство с английским и его звуковой стороной. По итогу уровня вы умеете поздороваться и представиться, назвать простые предметы и понимаете, как буквы связаны со звуками.",
    from: null,
    items: [
      "Темы для разговора: знакомство, приветствия, семья и дом, простые предметы вокруг.",
      "Словарный запас: первые ~200 слов — семья, дом, цвета.",
      "Речь: короткие приветствия и ответы на простые вопросы о себе.",
      "Произношение: алфавит, базовые звуки и чтение транскрипции."
    ]
  },
  A1: {
    desc: "Базовый уровень, на котором появляется «я могу объясниться»: рассказать о себе и о том, что происходит вокруг. По итогу вы строите простые утверждения и вопросы в настоящем и прошедшем и понимаете знакомые фразы в медленной речи.",
    from: "A0",
    items: [
      "Темы: рассказ о себе и семье, распорядок дня, еда и одежда, числа и время.",
      "Словарный запас: ~500–700 слов — повседневные действия, предметы, прилагательные для описания.",
      "Речь: простые утверждения и вопросы о настоящем и прошлом, короткие диалоги.",
      "На слух: медленная чёткая речь, знакомые фразы и вопросы."
    ]
  },
  A2: {
    desc: "Уровень путешественника: уверенность в простых ситуациях — заказ, покупка, ориентирование. По итогу вы рассказываете о планах и прошлом, сравниваете варианты и просите о помощи, когда чего-то не понимаете.",
    from: "A1",
    items: [
      "Темы: планы и будущее, поездки и город, сравнения, что происходит прямо сейчас.",
      "Словарный запас: ~1200–1500 слов — путешествия, магазины, предлоги места и времени.",
      "Речь: объясниться в кафе, гостинице и транспорте без подготовки; рассказать о прошлом и планах.",
      "На слух: основные моменты простых текстов, объявлений и неспешных диалогов."
    ]
  },
  B1: {
    desc: "Уровень самостоятельности: вы перестаёте переводить каждое слово и поддерживаете разговор на знакомые темы. По итогу вы рассказываете истории, выражаете мнение, объясняете причины и пересказываете чужие слова.",
    from: "A2",
    items: [
      "Темы: мнения и их обоснование, истории из жизни, опыт и результаты, условные ситуации.",
      "Словарный запас: ~2500 слов — неправильные глаголы, связки, первые фразовые глаголы.",
      "Речь: связный рассказ, пересказ чужих слов, обсуждение знакомых тем; уверенность в поездках.",
      "На слух: фильмы и подкасты в умеренном темпе, основное в несложных статьях."
    ]
  },
  B2: {
    desc: "Уровень уверенного владения: вы говорите подробно и точно и справляетесь с неожиданными темами. По итогу вы обосновываете мнение, обсуждаете абстрактные вопросы, выражаете сожаление и предположения о прошлом.",
    from: "B1",
    items: [
      "Темы: абстрактные вопросы, дискуссии, сожаление и предположения о прошлом, придаточные.",
      "Словарный запас: ~4000–5000 слов — оттенки синонимов, устойчивые связки.",
      "Речь: подробные высказывания с аргументацией, естественный темп, неожиданные темы не сбивают.",
      "На слух: живая речь носителей, фильмы без опоры на субтитры, сложные статьи."
    ]
  },
  C1: {
    desc: "Уровень гибкости: язык перестаёт ограничивать мысль. По итогу вы точно передаёте оттенки смысла, перестраиваете предложение для акцента и понимаете сложные тексты и носителей в быстром темпе.",
    from: "B2",
    items: [
      "Темы: любые знакомые и профессиональные; точные формулировки, фокус и инверсия.",
      "Словарный запас: ~8000 слов — идиомы, устойчивые сочетания, стилистические варианты.",
      "Речь: выразительная и почти без усилий; длинные высказывания со структурой и оттенками.",
      "На слух: сложные тексты, скрытый смысл, быстрая речь носителей."
    ]
  },
  C2: {
    desc: "Уровень мастерства: язык становится инструментом под задачу. По итогу вы свободно переключаетесь между формальным и неформальным, точно передаёте нюансы и говорите и пишете на сложные темы без подготовки.",
    from: "C1",
    items: [
      "Темы: любые, включая специальные и академические; точная передача нюансов.",
      "Словарный запас: ~12000+ слов — редкие конструкции и осознанный выбор регистра.",
      "Речь: как у образованного носителя — свободно, идиоматично, без подготовки.",
      "На слух: любые источники, включая иронию, подтекст и стилистические игры."
    ]
  }
};
---

<Base title="Грамматика по уровням — EnglishNotes">
  <section class="section wrap">
    <div class="catalog">
      <aside class="catalog__nav" aria-label="Уровни">
        {usedLevels.map((lvl) => (
          <a href={'#' + lvl} class="level-link" data-level-link data-level={lvl}>
            <span class="level-link__lvl">{lvl}</span>
            <span class="level-link__n">{byLevel(lvl).length}</span>
          </a>
        ))}
      </aside>

      <div class="catalog__body" id="top">
        <div class="section__head" data-reveal>
          <div>
            <p class="eyebrow">grammar · CEFR</p>
            <h2>Грамматика по уровням</h2>
          </div>
        </div>

        {usedLevels.map((lvl) => {
          const list = byLevel(lvl);
          return (
            <div class="level-block" id={lvl} data-level-block data-reveal>
              <div class="level-block__title">{lvl} <small>{list.length} тем</small></div>
              {levelMeta[lvl] && (
                <div class="level-intro">
                  <p class="level-intro__desc">{levelMeta[lvl].desc}</p>
                  <p class="level-intro__more-t">что нужно уметь и знать</p>
                  <ul class="level-intro__more">
                    {levelMeta[lvl].from && (
                      <li class="level-intro__from">Всё, что для {levelMeta[lvl].from}, плюс:</li>
                    )}
                    {levelMeta[lvl].items.map((e) => (
                      <li>{e}</li>
                    ))}
                  </ul>
                </div>
              )}
              <div class="topic-grid">
                {list.map((t) => (
                  <a href={'/grammar/' + t.slug} class="topic-card">
                    <div class="meta">
                      <span class="tag tag--lvl">{t.level}</span>
                      <span class="tag">{t.category}</span>
                    </div>
                    <h3>{t.title}</h3>
                    <p class="muted" style="font-size:14px;margin:0">{t.summary}</p>
                    <span class="muted" style="font-size:13px;margin-top:auto">≈ {t.readingTime} мин · читать →</span>
                  </a>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
</Base>