---
import Base from "../../layouts/Base.astro";
import Quiz from "../../components/Quiz.astro";

export async function getStaticPaths() {
  const files = import.meta.glob("../../data/vocabulary/*.json", { eager: true });
  return Object.values(files)
    .filter(f => f?.slug)
    .map(f => ({ params: { slug: f.slug }, props: { topic: f } }));
}

const { topic } = Astro.props;
---

<Base title={`${topic.title} — Словарный запас — EnglishNotes`}>
  <div class="vocabulary-topic">
    <nav class="vocabulary-topic__breadcrumb">
      <a href="/vocabulary">← Все темы</a>
    </nav>

    <header class="vocabulary-topic__header">
      <h1>{topic.title}</h1>
      <p class="vocabulary-topic__sub">{topic.titleRu}</p>
      <p class="vocabulary-topic__intro">{topic.intro}</p>
    </header>

    {topic.groups && topic.groups.length > 0 ? (
      topic.groups.map((group) => (
        <section class="vocabulary-group">
          <h2 class="vocabulary-group__title">{group.groupName}</h2>
          <p class="vocabulary-group__sub">{group.groupNameRu}</p>
          <div class="vocabulary-group__words">
            {group.words.map((word) => (
              <div class="vocab-word">
                <div class="vocab-word__main">
                  <span class="vocab-word__en">
                    {word.v1 ? `${word.v1} — ${word.v2} — ${word.v3}` : word.en}
                  </span>
                  {word.transcription && (
                    <span class="vocab-word__ipa">{word.transcription}</span>
                  )}
                </div>
                <span class="vocab-word__ru">{word.ru}</span>
              </div>
            ))}
          </div>
        </section>
      ))
    ) : (
      <section class="vocabulary-group">
        <div class="vocabulary-group__words">
          {topic.words && topic.words.map((word) => (
            <div class="vocab-word">
              <div class="vocab-word__main">
                <span class="vocab-word__en">{word.en}</span>
                {word.transcription && (
                  <span class="vocab-word__ipa">{word.transcription}</span>
                )}
              </div>
              <span class="vocab-word__ru">{word.ru}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    {topic.phrases && topic.phrases.length > 0 && (
      <section class="vocabulary-phrases">
        <h2>Примеры фраз</h2>
        <div class="vocabulary-phrases__list">
          {topic.phrases.map((phrase) => (
            <div class="vocab-phrase">
              <span class="vocab-phrase__en">{phrase.en}</span>
              <span class="vocab-phrase__ru">{phrase.ru}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    {topic.quiz && topic.quiz.length > 0 && (
      <section class="vocabulary-quiz">
        <h2>Проверь себя</h2>
        <Quiz quizData={topic.quiz} />
      </section>
    )}
  </div>
</Base>

<style>
  .vocabulary-topic {
    max-width: 820px;
    margin: 0 auto;
    padding: 32px 28px 60px;
  }
  .vocabulary-topic__breadcrumb {
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 32px;
  }
  .vocabulary-topic__breadcrumb a {
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 0.15s;
  }
  .vocabulary-topic__breadcrumb a:hover {
    color: var(--mint-ink);
  }
  .vocabulary-topic__header {
    margin-bottom: 44px;
  }
  .vocabulary-topic__header h1 {
    font-family: "Onest", system-ui, sans-serif;
    font-size: 38px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: 4px;
  }
  .vocabulary-topic__sub {
    font-family: "Lora", serif;
    font-size: 18px;
    color: var(--ink-mid);
    margin-bottom: 16px;
  }
  .vocabulary-topic__intro {
    font-family: "Lora", serif;
    font-size: 16px;
    line-height: 1.7;
    color: var(--ink-soft);
  }
  .vocabulary-group {
    margin-bottom: 40px;
  }
  .vocabulary-group__title {
    font-family: "Onest", system-ui, sans-serif;
    font-size: 22px;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 2px;
  }
  .vocabulary-group__sub {
    font-family: "Manrope", system-ui, sans-serif;
    font-size: 14px;
    color: var(--ink-soft);
    margin-bottom: 16px;
  }
  .vocabulary-group__words {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .vocab-word {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 16px;
    border-radius: 8px;
    background: var(--surface);
    border: 1px solid var(--line);
    transition: background 0.15s;
  }
  .vocab-word:hover {
    background: var(--mint);
    border-color: var(--mint-deep);
  }
  .vocab-word__main {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .vocab-word__en {
    font-family: "Manrope", system-ui, sans-serif;
    font-size: 16px;
    font-weight: 500;
    color: var(--ink);
  }
  .vocab-word__ipa {
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    color: var(--ink-soft);
  }
  .vocab-word__ru {
    font-family: "Manrope", system-ui, sans-serif;
    font-size: 15px;
    color: var(--ink-mid);
  }
  .vocabulary-phrases {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1.5px solid var(--line);
  }
  .vocabulary-phrases h2 {
    font-family: "Onest", system-ui, sans-serif;
    font-size: 24px;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 16px;
  }
  .vocabulary-phrases__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .vocab-phrase {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 18px;
    background: var(--surface);
    border-radius: 10px;
    border: 1px solid var(--line);
  }
  .vocab-phrase__en {
    font-family: "Lora", serif;
    font-size: 17px;
    color: var(--ink);
  }
  .vocab-phrase__ru {
    font-family: "Manrope", system-ui, sans-serif;
    font-size: 14px;
    color: var(--ink-soft);
  }
  .vocabulary-quiz {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1.5px solid var(--line);
  }
  .vocabulary-quiz h2 {
    font-family: "Onest", system-ui, sans-serif;
    font-size: 24px;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 20px;
  }
  @media (max-width: 600px) {
    .vocabulary-topic {
      padding: 20px 16px 40px;
    }
    .vocabulary-topic__header h1 {
      font-size: 28px;
    }
    .vocab-word {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
    }
    .vocab-word__ru {
      font-size: 14px;
    }
  }
</style>
