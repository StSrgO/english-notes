---
import Base from "../../layouts/Base.astro";
import Quiz from "../../components/Quiz.astro";
import quizBank from "../../data/quiz-bank.json";
import verbQuizzes from "../../data/vocabulary/irregular-verbs-quiz.json";

export async function getStaticPaths() {
  const files = import.meta.glob("../../data/vocabulary/*.json", { eager: true });
  return Object.values(files)
    .filter(f => f?.slug)
    .map(f => ({ params: { slug: f.slug }, props: { topic: f } }));
}

const { topic } = Astro.props;
// Тренажёр неправильных глаголов: новая схема данных (§3.1) — группы с ipa/rank.
// Для остальных тем словаря — прежний рендер (фолбэк).
const isVerbTrainer =
  topic.slug === "irregular-verbs" &&
  Array.isArray(topic.groups) &&
  topic.groups.some(g => g.words?.some(w => Array.isArray(w.ipa)));
const totalVerbs = isVerbTrainer ? topic.total || 0 : 0;
// «Вторая и третья формы …» в названиях групп — коротко v2/v3
const shortGroupName = (s) => String(s).replace("Вторая и третья формы", "v2/v3");
// Якорь слова на странице темы: 'w-' + слаг (в тренажёре якорь '#w-<v1>').
// Слаг повторяет функцию из search.json.ts — ссылки поиска ведут на эти id.
const wSlug = (s) => String(s).toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
// Тематическая тема (не тренажёр форм): группы слов {en, ru, example} —
// рендерится в том же лейауте тренажёра (меню, строки, озвучка).
const isTopicTrainer =
  !isVerbTrainer &&
  Array.isArray(topic.groups) &&
  topic.groups.some((g) => g.words?.some((w) => w.en && !w.v1));
const topicWordCount = Array.isArray(topic.groups)
  ? topic.groups.reduce((n, g) => n + (g.words?.length || 0), 0)
  : topic.total || topic.words?.length || 0;
---

<Base title={`${topic.title} — Словарный запас — EnglishNotes`}>
  <div class="vocabulary-topic">
    {
      isVerbTrainer ? (
        <>
          <div class="vocab-trainer">
            <aside class="vocab-side" aria-label="Содержание страницы">
              <nav class="vocab-side__nav">
                {topic.groups.map((group, i) => (
                  <a class="vocab-side__link" href={`#${group.id}`} data-side-spy={group.id}>
                    <span class="vocab-side__n">{String(i + 1).padStart(2, "0")}</span>
                    <span class="vocab-side__name">{shortGroupName(group.groupNameRu)}</span>
                    <span class="vocab-side__count">{group.words.length}</span>
                  </a>
                ))}
                <div class="vocab-side__sections">
                  <a class="vocab-side__link" href="#vocab-progress" data-side-spy="vocab-progress">
                    <span class="vocab-side__name">Прогресс</span>
                  </a>
                  <a class="vocab-side__link" href="#vocab-mix" data-side-spy="vocab-mix">
                    <span class="vocab-side__name">Микс слов</span>
                  </a>
                  <a class="vocab-side__link" href="#verb-quiz-host" data-side-spy="verb-quiz-host">
                    <span class="vocab-side__name">Проверь себя</span>
                  </a>
                </div>
              </nav>
            </aside>

            <div class="vocab-layout__main">
              <header class="vocabulary-topic__header vocab-topic-head">
                <p class="vocab-stats__eyebrow" id="verbs-count-label">
                  {totalVerbs} глаголов · {topic.groups.length} групп
                </p>
                <h1><span class="hl-mark">{topic.title}</span></h1>
                <p class="vocabulary-topic__sub">{topic.titleRu}</p>
                <p class="vocabulary-topic__intro">{topic.intro}</p>
              </header>

          {topic.groups.map((group, gi) => (
            <section class="vocab-group" id={group.id} data-group>
              <header class="vocab-group__head">
                <div class="vocab-group__titles">
                  <h2 class="vocab-group__title">
                    <span class="vocab-group__num">{String(gi + 1).padStart(2, "0")}</span>
                    {group.groupName}
                  </h2>
                  <p class="vocab-group__sub">{group.groupNameRu}</p>
                </div>
                <div class="vocab-group__actions">
                  <button type="button" class="vocab-quiz-btn" data-quiz-group={group.id}>Квиз по группе</button>
                  <span class="vocab-group__count">{group.words.length}</span>
                </div>
              </header>

              <ul class="vocab-rows" role="list">
                {group.words.map((word) => (
                  <li
                    class="vocab-row"
                    id={'w-' + word.v1}
                    data-v1={word.v1}
                  >
                    <label class="vocab-row__check">
                      <input
                        class="vocab-row__checkbox"
                        type="checkbox"
                        data-known
                        aria-label={`Отметить ${word.v1} как выученный`}
                      />
                      <span class="vocab-row__checkmark" aria-hidden="true"></span>
                    </label>

                    <div class="vocab-row__forms">
                      {[word.v1, word.v2, word.v3].map((form, fi) => (
                        <div class="vocab-form" data-form>
                          <span class="vocab-form__word">{form}</span>
                          {word.ipa?.[fi] && (
                            <span class="vocab-form__ipa">{word.ipa[fi]}</span>
                          )}
                        </div>
                      ))}
                    </div>

                    <div class="vocab-row__ruwrap">
                      <span class="vocab-row__ru">{word.ru}</span>
                      <span class="vocab-row__ex-tag">пример ›</span>
                    </div>

                    <span class="vocab-row__rank" aria-label={`Ранг ${word.rank} по частотности`}>
                      #{word.rank}
                    </span>

                    <button
                      type="button"
                      class="vocab-row__play"
                      data-play={[word.v1, word.v2, word.v3].join("|")}
                      aria-label={`Озвучить ${word.v1}, ${word.v2}, ${word.v3}`}
                    >
                      <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
                        <path
                          d="M4 9.5v5a1 1 0 0 0 1 1h3l4.2 3.4a.6.6 0 0 0 1-.47V5.57a.6.6 0 0 0-1-.47L8 8.5H5a1 1 0 0 0-1 1Z"
                          fill="currentColor"
                        />
                        <path
                          d="M15.5 8.6a4.6 4.6 0 0 1 0 6.8M18 6.4a8 8 0 0 1 0 11.2"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linecap="round"
                        />
                      </svg>
                      <span class="sr-only">Озвучить</span>
                    </button>

                    {word.example && (
                      <div class="vocab-example">
                        <span class="vocab-example__en">{word.example.en}</span>
                        <span class="vocab-example__ru">{word.example.ru}</span>
                      </div>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          ))}

          <section class="vocab-progress-plate" id="vocab-progress" data-side-spy="vocab-progress" aria-label="Прогресс изучения">
            <div class="vocab-progress-plate__head">
              <span class="vocab-progress-plate__label">Прогресс изучения</span>
              <span class="vocab-progress-plate__num" id="progress-label">Изучено 0 / {totalVerbs}</span>
            </div>
            <div class="vocab-progress__bar" aria-hidden="true">
              <span class="vocab-progress__fill" id="progress-fill"></span>
            </div>
            <p class="vocab-progress-plate__hint">Отмечай выученные глаголы галочкой слева — прогресс сохранится в этом браузере.</p>
          </section>

          <div class="vocab-quizbar" id="vocab-mix" data-side-spy="vocab-mix">
            <button type="button" class="vocab-quiz-btn vocab-quiz-btn--mix" data-quiz-mix>Микс · 20 случайных</button>
            <p class="vocab-quizbar__hint">Проверка соберётся из 20 случайных глаголов всех групп. Квиз по одной группе запускается её кнопкой «Квиз по группе».</p>
          </div>

          <section class="vocab-quiz" id="verb-quiz-host">
            <p class="vocab-quiz__idle">Квизы собираются из слов страницы. Выбери «Квиз по группе» у любой группы или запусти «Микс» — проверка появится здесь.</p>
          </section>

          <script is:inline define:vars={{ pool: verbQuizzes.groupQuizzes, quizUi: quizBank.__ui }}>
            (function () {
              const host = document.getElementById("verb-quiz-host");
              if (!host) return;
              const shuffle = (a) => { for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); const t = a[i]; a[i] = a[j]; a[j] = t; } return a; };
              const start = (questions) => {
                host.innerHTML = "";
                const sec = document.createElement("section");
                sec.className = "quiz";
                sec.dataset.quiz = JSON.stringify({ questions, ui: quizUi });
                host.appendChild(sec);
                document.dispatchEvent(new CustomEvent("quiz:mount", { detail: { root: sec } }));
                sec.scrollIntoView({ behavior: "smooth", block: "start" });
              };
              document.addEventListener("click", (e) => {
                const g = e.target.closest("[data-quiz-group]");
                if (g && pool && pool[g.dataset.quizGroup]) { start(pool[g.dataset.quizGroup]); return; }
                const mix = e.target.closest("[data-quiz-mix]");
                if (mix && pool) start(shuffle(Object.values(pool).flat()).slice(0, 20));
              });
            })();
          </script>
            </div>
          </div>
        </>
      ) : (
        <>
          <div class="vocab-trainer">
            <aside class="vocab-side" aria-label="Содержание страницы">
              <nav class="vocab-side__nav">
                {topic.groups.map((group, i) => (
                  <a class="vocab-side__link" href={`#${group.id}`} data-side-spy={group.id}>
                    <span class="vocab-side__n">{String(i + 1).padStart(2, "0")}</span>
                    <span class="vocab-side__name">{group.groupName}</span>
                    <span class="vocab-side__count">{group.words.length}</span>
                  </a>
                ))}
                <div class="vocab-side__sections">
                  <a class="vocab-side__link" href="#pv-quiz" data-side-spy="pv-quiz">
                    <span class="vocab-side__name">Проверь себя</span>
                  </a>
                </div>
              </nav>
            </aside>

            <div class="vocab-layout__main">
              <header class="vocabulary-topic__header vocab-topic-head">
                <p class="vocab-stats__eyebrow">
                  {topicWordCount} глаголов · {topic.groups.length} групп
                </p>
                <h1><span class="hl-mark">{topic.title}</span></h1>
                <p class="vocabulary-topic__sub">{topic.titleRu}</p>
                <p class="vocabulary-topic__intro">{topic.intro}</p>
              </header>

              {topic.groups.map((group, gi) => (
                <section class="vocab-group" id={group.id} data-group>
                  <header class="vocab-group__head">
                    <div class="vocab-group__titles">
                      <h2 class="vocab-group__title">
                        <span class="vocab-group__num">{String(gi + 1).padStart(2, "0")}</span>
                        {group.groupName}
                      </h2>
                      <p class="vocab-group__sub">{group.groupNameRu}</p>
                    </div>
                    <div class="vocab-group__actions">
                      <span class="vocab-group__count">{group.words.length}</span>
                    </div>
                  </header>

                  <ul class="vocab-rows" role="list">
                    {group.words.map((word) => (
                      <li
                        class="vocab-row vocab-row--pv"
                        id={'w-' + wSlug(word.en)}
                        data-pv
                      >
                        <button
                          type="button"
                          class="vocab-row__play"
                          data-play={[word.en, word.example && word.example.en].filter(Boolean).join("|")}
                          aria-label={`Озвучить ${word.en}`}
                        >
                          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
                            <path
                              d="M4 9.5v5a1 1 0 0 0 1 1h3l4.2 3.4a.6.6 0 0 0 1-.47V5.57a.6.6 0 0 0-1-.47L8 8.5H5a1 1 0 0 0-1 1Z"
                              fill="currentColor"
                            />
                            <path
                              d="M15.5 8.6a4.6 4.6 0 0 1 0 6.8M18 6.4a8 8 0 0 1 0 11.2"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.7"
                              stroke-linecap="round"
                            />
                          </svg>
                          <span class="sr-only">Озвучить</span>
                        </button>

                        <div class="vocab-pv__word">
                          <span class="vocab-pv__en">{word.en}</span>
                          {word.transcription && (
                            <span class="vocab-pv__ipa">{word.transcription}</span>
                          )}
                        </div>

                        <div class="vocab-row__ruwrap">
                          <span class="vocab-row__ru">{word.ru}</span>
                          <span class="vocab-row__ex-tag">пример ›</span>
                        </div>

                        {word.example && (
                          <div class="vocab-example">
                            <span class="vocab-example__en">{word.example.en}</span>
                            <span class="vocab-example__ru">{word.example.ru}</span>
                          </div>
                        )}
                      </li>
                    ))}
                  </ul>
                </section>
              ))}

              {topic.quiz && topic.quiz.length > 0 && (
                <section class="vocab-pv-quiz" id="pv-quiz" data-side-spy="pv-quiz">
                  <h2 class="vocab-pv-quiz__title">Проверь себя</h2>
                  <Quiz questions={topic.quiz} ui={quizBank.__ui} />
                </section>
              )}
            </div>
          </div>
        </>
      )
    }
  </div>
</Base>

{
  (isVerbTrainer || isTopicTrainer) && (
    <script>
      // ---------- Прогресс «знаю» (localStorage englishnotes.vocab.v1) ----------
      const STORE_KEY = "englishnotes.vocab.v1";
      const readKnown = () => {
        try { const s = localStorage.getItem(STORE_KEY); return s ? new Set(JSON.parse(s)) : new Set(); }
        catch { return new Set(); }
      };
      let known = readKnown();
      const rows = Array.from(document.querySelectorAll("[data-v1]"));
      const fill = document.getElementById("progress-fill");
      const label = document.getElementById("progress-label");
      const total = rows.length;
      const paint = () => {
        let done = 0;
        rows.forEach((row) => {
          const on = known.has(row.dataset.v1);
          row.classList.toggle("is-known", on);
          const cb = row.querySelector("[data-known]");
          if (cb) cb.checked = on;
          if (on) done++;
        });
        if (fill) fill.style.width = total ? `${Math.round((done / total) * 100)}%` : "0%";
        if (label) label.textContent = `Изучено ${done} / ${total}`;
      };
      const save = () => {
        try { localStorage.setItem(STORE_KEY, JSON.stringify([...known])); } catch {}
        paint();
      };
      document.addEventListener("change", (e) => {
        const cb = e.target.closest("[data-known]");
        if (!cb) return;
        const row = cb.closest("[data-v1]");
        if (!row) return;
        const v1 = row.dataset.v1;
        if (cb.checked) known.add(v1); else known.delete(v1);
        save();
      });
      paint();

      // ---------- Аудио: speechSynthesis трёх форм (en-GB, фолбэк en-US) ----------
      const pickVoice = (voices) =>
        voices.find((v) => /^en-GB/i.test(v.lang)) ||
        voices.find((v) => /^en[-_]US/i.test(v.lang)) ||
        voices.find((v) => /^en/i.test(v.lang)) ||
        null;
      let voice = null;
      const setVoice = () => {
        const vs = window.speechSynthesis ? speechSynthesis.getVoices() : [];
        voice = pickVoice(vs);
      };
      if (window.speechSynthesis) {
        setVoice();
        speechSynthesis.onvoiceschanged = setVoice;
      }
      const speakRow = (forms) => {
        if (!window.speechSynthesis) return;
        speechSynthesis.cancel();
        forms.split("|").forEach((form, i) => {
          const u = new SpeechSynthesisUtterance(form);
          if (voice) u.voice = voice;
          u.lang = voice ? voice.lang : "en-GB";
          u.rate = 0.92;
          setTimeout(() => speechSynthesis.speak(u), i * 750);
        });
      };
      document.addEventListener("click", (e) => {
        const btn = e.target.closest("[data-play]");
        if (btn) speakRow(btn.dataset.play);
      });

      // ---------- Примеры-фразы: раскрытие по клику на строку ----------
      document.addEventListener("click", (e) => {
        const row = e.target.closest(".vocab-row");
        if (!row) return;
        if (e.target.closest("a, button, input, label")) return; // свои контролы
        row.classList.toggle("is-open");
      });

      // ---------- Глобальный поиск: переход к слову по якорю #w-<v1> ----------
      // При заходе на страницу с якорем слова — центрируем строку и на
      // секунду подсвечиваем её, чтобы было видно, куда вёл результат.
      const flashWord = () => {
        const h = location.hash.replace("#", "");
        if (!h.startsWith("w-")) return;
        const row = document.getElementById(h);
        if (!row || !row.classList.contains("vocab-row")) return;
        row.scrollIntoView({ block: "center" });
        row.classList.add("is-hit");
        clearTimeout(flashWord._t);
        flashWord._t = setTimeout(() => row.classList.remove("is-hit"), 2400);
      };
      flashWord();
      window.addEventListener("pageshow", flashWord);

      // ---------- Scrollspy: активный раздел (единое правило скролл-баров) ----------
      // Активна последняя секция, чей верх поднялся выше линии чтения
      // (30% высоты окна); у верха страницы — первый пункт. Активный чип
      // автопрокруткой центрируется в ленте; пересчёт на pageshow /
      // visibilitychange (возврат из другой вкладки или bfcache).
      const sideLinks = Array.from(document.querySelectorAll("a[data-side-spy]"));
      const spySecs = sideLinks.map((l) => document.getElementById(l.dataset.sideSpy)).filter(Boolean);
      if (sideLinks.length && spySecs.length) {
        const line = () => window.innerHeight * 0.3;
        // Конец страницы: последняя секция может не дойти верхом до линии
        // чтения — тогда активна она (иначе последний пункт внизу страницы
        // никогда не подсвечивается).
        const atBottom = () =>
          window.scrollY + window.innerHeight >= Math.max(document.documentElement.scrollHeight, document.body.scrollHeight) - 4;
        const lineCur = () => {
          let cur = "";
          for (const s of spySecs) {
            if (s.getBoundingClientRect().top <= line()) cur = s.id;
          }
          return cur || sideLinks[0].dataset.sideSpy;
        };
        let lastId = "";
        const setSpy = (id) => {
          sideLinks.forEach((l) => l.classList.toggle("is-active", l.dataset.sideSpy === id));
          if (id === lastId) return;
          lastId = id;
          const act = sideLinks.find((l) => l.dataset.sideSpy === id);
          const nav = act && act.closest(".vocab-side__nav");
          if (nav && nav.scrollWidth > nav.clientWidth) {
            const nr = nav.getBoundingClientRect();
            const ar = act.getBoundingClientRect();
            nav.scrollTo({ left: nav.scrollLeft + (ar.left - nr.left) - (nav.clientWidth - ar.width) / 2, behavior: "smooth" });
          }
        };

        // Клик по пункту меню — это выбор пункта (как на лентах уровней):
        // чип подсвечивается сразу, страница плавно едет к секции. Секции
        // внизу страницы (прогресс/микс/проверка) короче, чем расстояние
        // до линии чтения, — их верх не поднимется выше 30% окна, и спай
        // не смог бы их показать. Поэтому выбранный тапом пункт «закрепляется»:
        // пока он виден у нижнего края страницы, активен он; правило снова
        // вступает в силу, когда пользователь уезжает от него (или тапает
        // другой пункт).
        let pinnedId = "";
        let programmatic = false;
        let pinDest = -1;
        let pinBase = 0;
        let pinTimer = 0;
        const finishProgrammatic = () => {
          if (!programmatic) return;
          programmatic = false;
          pinBase = window.scrollY;
        };
        const current = () => {
          if (programmatic && pinnedId) return pinnedId;
          if (atBottom()) {
            if (pinnedId) {
              const t = document.getElementById(pinnedId);
              if (t && t.getBoundingClientRect().top < window.innerHeight) return pinnedId;
            }
            return spySecs[spySecs.length - 1].id;
          }
          const id = lineCur();
          if (!programmatic && pinnedId && id !== pinnedId && Math.abs(window.scrollY - pinBase) > 60) pinnedId = "";
          return id;
        };
        let ticking = false;
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            ticking = false;
            if (programmatic && pinDest >= 0 && Math.abs(window.scrollY - pinDest) <= 2) finishProgrammatic();
            setSpy(current());
          });
        };
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("pageshow", onScroll);
        document.addEventListener("visibilitychange", () => {
          if (document.visibilityState === "visible") onScroll();
        });
        setSpy(current());

        sideLinks.forEach((a) =>
          a.addEventListener("click", (e) => {
            e.preventDefault();
            const id = a.dataset.sideSpy;
            pinnedId = id;
            setSpy(id);
            const t = document.getElementById(id);
            if (!t) return;
            programmatic = true;
            clearTimeout(pinTimer);
            const margin = parseFloat(getComputedStyle(t).scrollMarginTop) || 0;
            const maxY = Math.max(document.documentElement.scrollHeight, document.body.scrollHeight) - window.innerHeight;
            pinDest = Math.max(0, Math.min(t.getBoundingClientRect().top + window.scrollY - margin, maxY));
            window.scrollTo({ top: pinDest, behavior: "smooth" });
            history.replaceState(null, "", "#" + id);
            pinTimer = setTimeout(finishProgrammatic, 4000);
          })
        );
      }
    </script>
  )
}

<style>
  /* ---------- общее (обе схемы) ---------- */
  .vocabulary-topic {
    max-width: 900px;
    margin: 0 auto;
    padding: 32px 28px 60px;
  }
  .vocabulary-topic__header { margin-bottom: 32px; }
  .vocabulary-topic__header h1 {
    font-family: var(--display);
    font-size: 38px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 2px 0 4px;
  }
  .vocabulary-topic__sub {
    font-family: var(--display-serif);
    font-size: 18px;
    color: var(--ink-mid);
    margin-bottom: 12px;
  }
  .vocabulary-topic__intro {
    font-family: var(--body);
    font-size: 15px;
    line-height: 1.65;
    color: var(--ink-soft);
    max-width: 60ch;
  }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  /* ---------- тренажёр: шапка внутри колонки слов ---------- */
  .vocab-stats__eyebrow {
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--mint-ink);
    margin: 0 0 6px;
  }
  .vocab-topic-head {
    margin: 0 0 26px;
  }
  /* заголовок с маркером-подчёркиванием, как в уроках и заметках */
  .vocab-topic-head h1 {
    font-family: var(--display-serif);
    font-size: clamp(30px, 3vw, 46px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.06;
    color: var(--ink);
    margin: 2px 0 8px;
    overflow-wrap: anywhere;
  }
  .vocab-topic-head .vocabulary-topic__sub {
    font-size: 19px;
    margin-bottom: 8px;
  }
  .vocab-topic-head .vocabulary-topic__intro {
    margin: 0;
    max-width: none;
    font-family: var(--display-serif);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.7;
    color: var(--ink-mid);
    text-align: justify;
    hyphens: auto;
    -webkit-hyphens: auto;
  }

  /* ---------- тренажёр: низ страницы — прогресс и микс ---------- */
  .vocab-progress-plate {
    margin-top: 52px;
    padding: 18px 20px 16px;
    background: var(--mint);
    border: 1.5px solid var(--mint-deep);
    border-radius: 16px;
    scroll-margin-top: calc(var(--head-h, 64px) + 60px);
  }
  .vocab-progress-plate__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 6px 12px;
    margin-bottom: 10px;
  }
  .vocab-progress-plate__label {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--mint-ink);
  }
  .vocab-progress-plate__num {
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 800;
    color: var(--ink);
    white-space: nowrap;
  }
  .vocab-progress__bar {
    height: 10px;
    border-radius: 99px;
    background: var(--surface);
    border: 1px solid var(--mint-deep);
    overflow: hidden;
  }
  .vocab-progress__fill {
    display: block;
    height: 100%;
    width: 0%;
    border-radius: 99px;
    background: var(--mint-ink);
    transition: width 0.25s ease;
  }
  .vocab-progress-plate__hint {
    margin: 10px 0 0;
    font-family: var(--display-serif);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--ink-mid);
  }
  #vocab-mix { scroll-margin-top: calc(var(--head-h, 64px) + 60px); }

  /* ---------- тренажёр: лейаут с боковым меню (как в уроках) ---------- */
  .vocabulary-topic:has(.vocab-trainer) { max-width: 1140px; }
  /* Тренажёр: меню слева, справа — шапка, группы и низ страницы.
     Меню .vocab-side стоит первым в разметке, чтобы на мобильном
     лента скролл-бара оказывалась сразу под шапкой (единое правило скролл-баров). */
  .vocab-trainer {
    display: grid;
    grid-template-columns: 230px minmax(0, 1fr);
    grid-template-areas: "side main";
    column-gap: 44px;
    align-items: start;
  }
  .vocab-trainer > .vocab-side { grid-area: side; }
  .vocab-trainer > .vocab-layout__main { grid-area: main; }
  .vocab-side {
    position: sticky;
    top: calc(var(--head-h, 64px) - 4px);
    max-height: calc(100vh - var(--head-h, 64px) - 20px);
    overflow-y: auto;
    padding: 4px 8px 4px 0;
    scrollbar-width: thin;
    scrollbar-color: var(--mint-deep) transparent;
  }
  .vocab-side::-webkit-scrollbar { width: 6px; }
  .vocab-side::-webkit-scrollbar-thumb { background: var(--mint-deep); border-radius: 3px; }
  .vocab-side__nav {
    display: grid;
    gap: 2px;
    border-left: 2px solid var(--line);
    margin-left: 2px;
  }
  .vocab-side__link {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 7px 10px 7px 14px;
    border-radius: 0 10px 10px 0;
    font-family: var(--body);
    font-size: 13.5px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 0.15s, background 0.15s, transform 0.15s;
  }
  /* hover (подсвечивание) — как в десктопной колонке /notes/{level}
     (.cheats-side): светлая mint-подложка + тёмный текст, без сдвига */
  .vocab-side__link:hover {
    color: var(--ink);
    background: var(--mint);
  }
  /* выбранный пункт — как .cheats-side__link.is-active на /notes/{level}:
     светлый mint + жирный тёмный текст + левый инсет-бар mint-ink */
  .vocab-side__link.is-active {
    color: var(--ink);
    font-weight: 700;
    background: var(--mint);
    box-shadow: inset 3px 0 0 var(--mint-ink);
    transform: none;
  }
  .vocab-side__link:focus-visible {
    outline: none;
    box-shadow: inset 3px 0 0 var(--mint-ink), 0 0 0 3px var(--mint);
  }
  .vocab-side__n {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    color: var(--mint-ink);
    flex: 0 0 auto;
  }
  .vocab-side__name { min-width: 0; }
  .vocab-side__count {
    margin-left: auto;
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    color: var(--ink-soft);
    flex: 0 0 auto;
  }
  /* раздел меню «Прогресс / Микс / Проверь себя» — отделён от групп */
  .vocab-side__sections {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 2px;
  }
  .vocab-side__sections .vocab-side__link {
    font-family: var(--mono);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  /* hover раздела — как у обычных пунктов колонки (тёмный текст на mint) */
  .vocab-side__sections .vocab-side__link:hover {
    color: var(--ink);
  }
  /* активный пункт раздела: цвет — тёмный (светлая подложка из общего
     .is-active); правило стоит ПОСЛЕ :hover и перебивает базовый
     mono-цвет ink-soft (специфичность (0,3,0) > (0,2,0)) */
  .vocab-side__sections .vocab-side__link.is-active {
    color: var(--ink);
  }
  .vocab-layout__main { min-width: 0; }

  /* ---------- тренажёр: группы ---------- */
  .vocab-group {
    scroll-margin-top: calc(var(--head-h, 64px) + 60px);
    margin-bottom: 38px;
  }
  .vocab-group__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }
  .vocab-group__title {
    font-family: var(--display);
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0 0 2px;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .vocab-group__num {
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 700;
    color: var(--mint-ink);
  }
  .vocab-group__sub {
    font-family: var(--display-serif);
    font-size: 14.5px;
    font-weight: 500;
    color: var(--ink-mid);
    margin: 0;
  }
  .vocab-group__count {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    color: var(--mint-ink);
    background: var(--mint);
    border-radius: 99px;
    padding: 3px 9px;
    white-space: nowrap;
  }
  .vocab-rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* ---------- тренажёр: строка-карточка ---------- */
  .vocab-row {
    display: grid;
    /* ширина колонки перевода фиксирована, чтобы три формы во всех
       строках группы начинались на одних и тех же позициях */
    grid-template-columns: 28px minmax(0, 1fr) 210px auto auto;
    grid-template-areas:
      "check forms ru rank play"
      "ex ex ex ex ex";
    align-items: center;
    gap: 2px 16px;
    padding: 8px 14px 8px 10px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
  }
  .vocab-row:hover { border-color: var(--mint-deep); }
  .vocab-row:has(.vocab-row__checkbox:focus-visible) {
    box-shadow: 0 0 0 3px var(--mint);
  }
  .vocab-row.is-known { background: var(--mint); border-color: var(--mint-deep); }
  .vocab-row[hidden] { display: none; }
  /* переход к слову по якорю из глобального поиска: запас под шапку и
     sticky-ленту, краткая подсветка строки */
  .vocab-row { scroll-margin-top: calc(var(--head-h, 64px) + 110px); }
  @keyframes vocab-hit {
    0% { background: var(--mint-deep); border-color: var(--mint-ink); box-shadow: 0 0 0 3px var(--mint); }
    100% { background: var(--surface); border-color: var(--line); box-shadow: none; }
  }
  .vocab-row.is-hit {
    animation: vocab-hit 1.5s ease 0.15s 1;
    border-color: var(--mint-ink);
  }

  .vocab-row__check { grid-area: check; position: relative; display: inline-flex; width: 22px; height: 22px; }
  .vocab-row__checkbox {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }
  .vocab-row__checkmark {
    width: 20px;
    height: 20px;
    border-radius: 6px;
    border: 1.5px solid var(--line);
    background: var(--paper);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.15s, background 0.15s;
    color: #fff;
  }
  .vocab-row__checkmark::after {
    content: "✓";
    font-size: 13px;
    font-weight: 800;
    opacity: 0;
    transform: scale(0.6);
    transition: opacity 0.12s, transform 0.12s;
  }
  .vocab-row__checkbox:checked + .vocab-row__checkmark {
    background: var(--mint-ink);
    border-color: var(--mint-ink);
  }
  .vocab-row__checkbox:checked + .vocab-row__checkmark::after { opacity: 1; transform: scale(1); }

  .vocab-row__forms {
    grid-area: forms;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px 14px;
    min-width: 0;
  }
  .vocab-form {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }
  .vocab-form__word {
    font-family: var(--display);
    font-size: 16.5px;
    font-weight: 800;
    color: var(--ink);
    line-height: 1.25;
    overflow-wrap: anywhere;
  }
  .vocab-row.is-known .vocab-form__word { color: var(--ink-mid); }
  .vocab-form__ipa {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--ink-soft);
  }
  .vocab-row.is-known .vocab-form__ipa { opacity: 0.8; }

  .vocab-row__ruwrap {
    grid-area: ru;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    min-width: 0;
  }
  .vocab-row__ru {
    font-family: var(--body);
    font-size: 14px;
    color: var(--ink-mid);
    text-align: right;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }
  .vocab-row.is-known .vocab-row__ru { color: var(--ink-soft); }
  .vocab-row__ex-tag {
    font-family: var(--mono);
    font-size: 9.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--mint-ink);
    opacity: 0.75;
  }
  .vocab-row:hover .vocab-row__ex-tag,
  .vocab-row.is-open .vocab-row__ex-tag { opacity: 1; }

  .vocab-row__rank {
    grid-area: rank;
    font-family: var(--mono);
    font-size: 10.5px;
    font-weight: 700;
    color: var(--ink-soft);
    white-space: nowrap;
  }
  .vocab-row__play {
    grid-area: play;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink-mid);
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, color 0.15s;
  }
  .vocab-row__play:hover { background: var(--mint); border-color: var(--mint-deep); color: var(--ink); }
  .vocab-row__play:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px var(--mint);
  }
  .vocab-row.is-known .vocab-row__play { background: transparent; }

  /* пример-фраза: раскрывается по клику на строку */
  .vocab-example {
    grid-column: 1 / -1;
    display: none;
    flex-direction: column;
    gap: 3px;
    margin: 4px 2px 2px;
    padding: 9px 14px;
    background: var(--paper);
    border: 1px dashed var(--mint-deep);
    border-radius: 10px;
  }
  .vocab-row.is-open .vocab-example { display: flex; }
  .vocab-example__en {
    font-family: var(--display-serif);
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink);
  }
  .vocab-example__ru {
    font-family: var(--body);
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink-mid);
  }

  /* ---------- тематическая тема (группы слов: en + перевод + пример) ---------- */
  /* Строка-карточка в том же лейауте, что тренажёр глаголов, но без форм:
     слева озвучка, слово с IPA, перевод; пример раскрывается кликом. */
  .vocab-row--pv {
    grid-template-columns: auto minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas:
      "play word ru"
      "ex ex ex";
  }
  .vocab-pv__word {
    grid-area: word;
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
    align-self: center;
  }
  .vocab-pv__en {
    font-family: var(--display);
    font-size: 16.5px;
    font-weight: 800;
    color: var(--ink);
    line-height: 1.25;
    overflow-wrap: anywhere;
  }
  .vocab-pv__ipa {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--ink-soft);
  }
  .vocab-row--pv .vocab-row__ruwrap { grid-area: ru; align-self: center; justify-self: end; }
  .vocab-row--pv .vocab-row__play { align-self: center; }
  /* раздел «Проверь себя» внизу тематической темы */
  .vocab-pv-quiz {
    scroll-margin-top: calc(var(--head-h, 64px) + 70px);
    margin-top: 44px;
    padding-top: 26px;
    border-top: 1.5px solid var(--line);
  }
  .vocab-pv-quiz__title {
    font-family: var(--display);
    font-size: 24px;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 20px;
  }

  /* ---------- мобильная: скролл-бар по единому правилу скролл-баров ---------- */
  @media (max-width: 1100px) {
    .vocabulary-topic:has(.vocab-trainer) { padding-top: 0; }
    .vocab-trainer { display: block; }
    /* sticky-обёртка не скроллится (iOS Safari): скролл живёт во внутреннем nav */
    .vocab-side {
      position: sticky;
      top: var(--head-h, 64px);
      z-index: 25;
      max-height: none;
      overflow: visible;
      margin: 0 -2px 20px;
      padding: 0;
      background-color: var(--paper);
      background-image: var(--bar-paper);
      border-bottom: 1px solid var(--line);
    }
    .vocab-side__nav {
      display: flex;
      flex-wrap: nowrap;
      align-items: center;
      gap: 8px;
      overflow-x: auto;
      border-left: none;
      margin-left: 0;
      padding: 10px 2px;
      scrollbar-width: none;
    }
    .vocab-side__nav::-webkit-scrollbar { display: none; }
    .vocab-side__link {
      flex: 0 0 auto;
      align-items: center;
      border-radius: 11px;
      background: none;
      padding: 8px 14px;
      font-family: var(--display);
      font-size: 19px;
      font-weight: 800;
      letter-spacing: -0.01em;
      line-height: 1.65;
      color: var(--ink);
      white-space: nowrap;
      transition: background 0.18s ease, color 0.18s ease, transform 0.18s ease;
    }
    /* hover (подсвечивание) чипа — как на /grammar: светлый mint-фон +
       зелёный текст var(--mint-ink) + сдвиг 3px (выбранное — темнее) */
    .vocab-side__link:hover {
      background: var(--mint);
      color: var(--mint-ink);
      transform: translateX(3px);
    }
    .vocab-side__link.is-active {
      background: var(--mint-ink);
      color: var(--paper);
      font-weight: 800;
      box-shadow: none;
      transform: none;
    }
    .vocab-side__n,
    .vocab-side__count { display: none; }
    /* нижние пункты меню (прогресс/микс/проверка) — обычные чипы ленты */
    .vocab-side__sections {
      display: contents;
      margin: 0;
      padding: 0;
      border: none;
    }
    .vocab-side__sections .vocab-side__link {
      font-family: var(--display);
      font-size: 19px;
      font-weight: 800;
      letter-spacing: -0.01em;
      text-transform: none;
      color: var(--ink);
      padding-top: 8px;
    }
    /* правило .vocab-side__sections .vocab-side__link (0,3,0) перебивало
       color у .is-active (0,2,0) — активный чип «Проверь себя» был с
       тёмным текстом на тёмно-зелёной подложке */
    .vocab-side__sections .vocab-side__link:hover {
      color: var(--mint-ink);
    }
    .vocab-side__sections .vocab-side__link.is-active {
      color: var(--paper);
    }
  }
  /* тач: hover после тапа «прилипает» — фон нажатия не должен
     переживать переход is-active на другой пункт (правило тач-гасилки);
     активный пункт не гасим, чтобы его подсветка оставалась видна */
  @media (hover: none), (pointer: coarse) {
    .vocab-side__link:not(.is-active):hover {
      background: transparent;
      transform: none;
    }
  }
  @media (max-width: 640px) {
    .vocabulary-topic { padding: 12px 14px 44px; }
    .vocabulary-topic__header h1 { font-size: clamp(26px, 8vw, 34px); }
    .vocab-progress-plate { padding: 15px 16px 14px; }
    .vocab-row {
      grid-template-columns: 26px minmax(0, 1fr) auto;
      grid-template-areas:
        "check forms rank"
        "check ru play"
        "ex ex ex";
      gap: 2px 12px;
      align-items: center;
      padding: 10px 12px 10px 8px;
    }
    .vocab-row__forms { gap: 8px 10px; }
    .vocab-form__word { font-size: 15px; }
    .vocab-form__ipa { font-size: 10px; }
    .vocab-row__ruwrap { align-items: flex-start; }
    .vocab-row__ru { text-align: left; max-width: none; font-size: 13.5px; }
    .vocab-row__rank { justify-self: end; }
    .vocab-row__play { width: 30px; height: 30px; }
    .vocab-group__head { align-items: flex-start; }
  }
  @media (prefers-reduced-motion: reduce) {
    .vocab-progress__fill { transition: none; }
    .vocab-row__checkmark::after { transition: none; }
  }

  /* ---------- тренажёр: низ страницы — микс и квиз (T8) ---------- */
  .vocab-quizbar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 14px;
