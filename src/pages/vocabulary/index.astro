---
import Base from "../../layouts/Base.astro";

const vocabularyFiles = import.meta.glob("../../data/vocabulary/*.json", { eager: true });
const topics = Object.values(vocabularyFiles)
  .filter(f => f?.slug && f?.title)
  .sort((a, b) => a.title.localeCompare(b.title));
---

<Base title="Словарный запас — EnglishNotes">
  <div class="vocabulary-page">
    <header class="vocabulary-header">
      <p class="eyebrow">vocabulary · words</p>
      <h1 class="page-title"><span class="hl-mark">Словарный запас</span></h1>
      <p class="vocabulary-lead">
        Словарный запас — подборки английских слов по темам. В каждой подборке слово
        показано целиком: его формы и произношение, перевод и пример употребления —
        так слово запоминается в контексте, а не отдельной строчкой из списка.
        Открой нужную тему из карточки, отметь слова, которые уже знаешь, послушай
        произношение и проверь себя квизом. Отмеченный прогресс сохраняется в браузере,
        так что в следующий раз ты продолжишь с того же места.
      </p>
    </header>
    <div class="vocabulary-divider" aria-hidden="true"></div>

    <div class="vocabulary-grid">
      {topics.map((topic) => {
        // темы с группами (тренажёр) — карточка со списком групп, как в меню
        // страницы тренажёра; обычные темы — простая карточка-ссылка
        const hasGroups = Array.isArray(topic.groups) && topic.groups.length > 0;
        if (!hasGroups) {
          return (
            <a href={`/vocabulary/${topic.slug}`} class="vocabulary-card">
              <h2 class="vocabulary-card__title">{topic.title}</h2>
              <p class="vocabulary-card__desc">{topic.titleRu}</p>
              {topic.intro && <p class="vocabulary-card__intro">{topic.intro}</p>}
              <span class="vocabulary-card__count">{topic.total ?? (topic.words?.length ?? 0)} слов</span>
            </a>
          );
        }
        const totalWords = topic.total ?? topic.groups.reduce((n, g) => n + (g.words?.length || 0), 0);
        const pad = (i) => String(i + 1).padStart(2, "0");
        // тренажёр форм (v1/v2/v3): имена групп в карточке — русские (типы форм);
        // тематические темы (слова {en}): группы-частицы называем по-английски
        const hasVerbForms = topic.groups.some((g) => g.words?.some((w) => w.v1));
        // компактное имя группы в карточке: длинное «Вторая и третья формы»
        // сокращаем до v2/v3, чтобы название целиком влезало в строку
        const shortName = (s) => String(s).replace("Вторая и третья формы", "v2/v3");
        const groupListName = (g) =>
          hasVerbForms ? shortName(g.groupNameRu || g.groupName) : g.groupName;
        return (
          <a href={`/vocabulary/${topic.slug}`} class="vocabulary-card vocabulary-card--groups">
            <h2 class="vocabulary-card__title">{topic.title}</h2>
            <p class="vocabulary-card__desc">{topic.titleRu}</p>
            <span class="vocabulary-card__count">{totalWords} слов · {topic.groups.length} {topic.groups.length === 1 ? "группа" : topic.groups.length < 5 ? "группы" : "групп"}</span>
            <ul class="vocabulary-card__groups">
              {topic.groups.map((g, i) => (
                <li class="vocabulary-card__group">
                  <span class="vocabulary-card__gn">{pad(i)}</span>
                  <span class="vocabulary-card__gname">{groupListName(g)}</span>
                  <span class="vocabulary-card__gcount">{g.words?.length || 0}</span>
                </li>
              ))}
            </ul>
          </a>
        );
      })}
    </div>
  </div>
</Base>

<style>
  .vocabulary-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 40px 28px 60px;
  }
  .vocabulary-header {
    margin-bottom: 0;
  }
  .vocabulary-header h1 {
    margin: 6px 0 14px;
  }
  .vocabulary-lead {
    font-family: var(--display-serif);
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-mid);
    max-width: none;
    text-align: justify;
    hyphens: auto;
    -webkit-hyphens: auto;
  }
  /* разделительная полоса под описанием — как заголовки уровней на /grammar */
  .vocabulary-divider {
    margin: 24px 0 34px;
    border-bottom: 2px solid var(--line-strong);
  }
  .vocabulary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 24px;
  }
  .vocabulary-card {
    display: block;
    background: var(--surface);
    border-radius: 16px;
    padding: 28px 24px;
    border: 1.5px solid var(--line);
    transition: all 0.2s;
    text-decoration: none;
    color: var(--ink);
  }
  .vocabulary-card:hover {
    border-color: var(--mint-deep);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(18, 52, 48, 0.06);
  }
  .vocabulary-card__title {
    font-family: var(--display);
    font-size: 20px;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 4px;
  }
  .vocabulary-card__desc {
    font-family: var(--body);
    font-size: 14px;
    color: var(--ink-soft);
    margin-bottom: 6px;
    line-height: 1.4;
  }
  .vocabulary-card__intro {
    font-family: var(--body);
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--ink-mid);
    margin: 0 0 14px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .vocabulary-card__count {
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 700;
    color: var(--mint-ink);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  /* карточка темы с группами: список групп, как в меню тренажёра
     (номер · русское название · сколько слов) */
  .vocabulary-card--groups {
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }
  .vocabulary-card__groups {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .vocabulary-card__group {
    display: flex;
    align-items: baseline;
    gap: 9px;
    padding: 6px 0;
    min-width: 0;
  }
  .vocabulary-card__group + .vocabulary-card__group {
    border-top: 1px solid var(--line);
  }
  .vocabulary-card__gn {
    flex: 0 0 auto;
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    color: var(--mint-ink);
  }
  .vocabulary-card__gname {
    flex: 1 1 auto;
    min-width: 0;
    font-size: 13.5px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--ink);
  }
  .vocabulary-card:hover .vocabulary-card__gname { color: var(--ink-mid); }
  .vocabulary-card__gcount {
    flex: 0 0 auto;
    font-family: var(--mono);
    font-size: 10.5px;
    font-weight: 700;
    color: var(--ink-soft);
  }
  @media (max-width: 600px) {
    .vocabulary-page {
      padding: 24px 16px 40px;
    }
    .vocabulary-header h1 {
      font-size: 30px;
    }
    .vocabulary-grid {
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    .vocabulary-card {
      padding: 20px 16px;
    }
    .vocabulary-card__title {
      font-size: 17px;
    }
  }
  @media (max-width: 420px) {
    .vocabulary-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
