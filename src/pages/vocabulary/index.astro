---
import Base from "../../layouts/Base.astro";

const vocabularyFiles = import.meta.glob("../../data/vocabulary/*.json", { eager: true });
const topics = Object.values(vocabularyFiles)
  .filter(f => f?.slug && f?.title)
  .sort((a, b) => a.title.localeCompare(b.title));
---

<Base title="Словарный запас — EnglishNotes">
  <div class="vocabulary-page">
    <header class="vocabulary-header">
      <h1>Словарный запас</h1>
      <p class="vocabulary-lead">
        Тематические подборки слов и выражений для реальной жизни.
        От еды до неправильных глаголов — учи слова в контексте.
      </p>
    </header>

    <div class="vocabulary-grid">
      {topics.map((topic) => (
        <a href={`/vocabulary/${topic.slug}`} class="vocabulary-card">
          <div class="vocabulary-card__icon">
            <span class="vocabulary-card__emoji">{topic.icon || "📚"}</span>
          </div>
          <h2 class="vocabulary-card__title">{topic.title}</h2>
          <p class="vocabulary-card__desc">{topic.titleRu}</p>
          <span class="vocabulary-card__count">{topic.words?.length || 0} слов</span>
        </a>
      ))}
    </div>
  </div>
</Base>

<style>
  .vocabulary-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 40px 28px 60px;
  }
  .vocabulary-header {
    margin-bottom: 44px;
  }
  .vocabulary-header h1 {
    font-family: "Onest", system-ui, sans-serif;
    font-size: 42px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: 12px;
  }
  .vocabulary-lead {
    font-family: "Lora", serif;
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-mid);
    max-width: 640px;
  }
  .vocabulary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 24px;
  }
  .vocabulary-card {
    display: block;
    background: var(--surface);
    border-radius: 16px;
    padding: 28px 24px;
    border: 1.5px solid var(--line);
    transition: all 0.2s;
    text-decoration: none;
    color: var(--ink);
  }
  .vocabulary-card:hover {
    border-color: var(--mint-deep);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(18, 52, 48, 0.06);
  }
  .vocabulary-card__icon {
    margin-bottom: 12px;
  }
  .vocabulary-card__emoji {
    font-size: 32px;
    line-height: 1;
  }
  .vocabulary-card__title {
    font-family: "Onest", system-ui, sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 4px;
  }
  .vocabulary-card__desc {
    font-family: "Manrope", system-ui, sans-serif;
    font-size: 14px;
    color: var(--ink-soft);
    margin-bottom: 12px;
    line-height: 1.4;
  }
  .vocabulary-card__count {
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    font-weight: 700;
    color: var(--mint-ink);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  @media (max-width: 600px) {
    .vocabulary-page {
      padding: 24px 16px 40px;
    }
    .vocabulary-header h1 {
      font-size: 30px;
    }
    .vocabulary-grid {
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    .vocabulary-card {
      padding: 20px 16px;
    }
    .vocabulary-card__title {
      font-size: 17px;
    }
  }
  @media (max-width: 420px) {
    .vocabulary-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
