---
import Base from '../layouts/Base.astro';
---
<Base title="Скоро · EnglishNotes">
  <section class="soon wrap">
    <div class="soon__text">
      <h1 class="soon__title">Something is coming.</h1>
      <p class="soon__sub">
        <span class="soon__st">Я бы рассказал, что именно.<br>Но тогда пропадёт интрига.</span>
        <span class="soon__st">Пока здесь только кот,<br>который делает вид, что всё под контролем.</span>
        <span class="soon__st">Он тоже ждёт.</span>
      </p>
      <a href="/" class="soon__back">← На главную</a>
    </div>
    <div class="soon__img" aria-hidden="true">
      <img src="/images/cat.webp" alt="" loading="lazy" />
    </div>
  </section>
</Base>
