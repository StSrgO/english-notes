---
import Base from '../layouts/Base.astro';
---
<Base title="Скоро · EnglishNotes">
  <section class="soon wrap">
    <div class="soon__text">
      <h1 class="soon__title">Появится скоро</h1>
      <p class="soon__sub">Мы очень работаем над этой страницей.<br>И иногдашеньки спим.<br>Цуцуть.</p>
      <a href="/" class="soon__back">← На главную</a>
    </div>
    <div class="soon__img" aria-hidden="true">
      <img src="/images/cat.png" alt="" loading="lazy" />
    </div>
  </section>
</Base>
