---
import Base from "../../layouts/Base.astro";
import { LEVELS } from "../../data/lesson-order.js";

const files = import.meta.glob("../../data/cheats/*.json", { eager: true, import: "default" });
const levels = Object.values(files)
  .filter((d) => d && d.level && Array.isArray(d.topics))
  .sort((a, b) => LEVELS.indexOf(a.level) - LEVELS.indexOf(b.level));
const total = levels.reduce((n, d) => n + d.topics.length, 0);
---

<Base title="Шпаргалки по грамматике — EnglishNotes" description={`Шпаргалки по грамматике английского: краткие схемы ${total} тем по уровням A0–C2 — когда используется, формула, примеры, частая ошибка.`}>
  <section class="cheats-index wrap">
    <header class="cheats-index__head">
      <nav class="cheats-crumb" aria-label="Хлебные крошки">
        <a href="/grammar">Грамматика</a>
        <span aria-hidden="true"> · </span>
        <span aria-current="page">Шпаргалки</span>
      </nav>
      <p class="eyebrow">grammar · cheats</p>
      <h1 class="cheats-index__h1"><span class="hl-mark">Шпаргалки</span></h1>
      <p class="cheats-index__lead">
        Краткие схемы по темам грамматики для быстрого повторения: когда используется,
        формула, один-два примера и частая ошибка — без истории и длинных объяснений.
        {total} тем на {levels.length} уровнях.
      </p>
    </header>

    <div class="cheats-grid">
      {levels.map((d) => {
        const level = d.level;
        const name = d.label && d.label.startsWith(level + " · ") ? d.label.slice(level.length + 3) : d.label;
        return (
          <a href={"/cheats/" + level.toLowerCase()} class="cheat-lvl">
            <span class="cheat-lvl__code">{level}</span>
            <span class="cheat-lvl__name">{name}</span>
            <span class="cheat-lvl__count">{d.topics.length} {d.topics.length === 1 ? "тема" : "тем"}</span>
          </a>
        );
      })}
    </div>
  </section>
</Base>

<style>
  .cheats-index { padding: 44px 0 72px; }
  .cheats-index__head { margin-bottom: 34px; }
  .cheats-crumb {
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    margin-bottom: 26px;
  }
  .cheats-crumb a { transition: color 0.15s; }
  .cheats-crumb a:hover { color: var(--mint-ink); }
  .cheats-index__h1 {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(34px, 5vw, 54px);
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin: 12px 0 14px;
  }
  .cheats-index__lead {
    max-width: 60ch;
    font-size: 17px;
    line-height: 1.7;
    color: var(--ink-mid);
    font-weight: 500;
    margin: 0;
  }

  .cheats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 16px;
  }
  .cheat-lvl {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 22px 20px 20px;
    background: var(--surface);
    border: 1.5px solid var(--line);
    border-radius: 16px;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .cheat-lvl:hover {
    transform: translateY(-3px);
    border-color: var(--mint-deep);
    box-shadow: var(--shadow-sm);
  }
  .cheat-lvl__code {
    font-family: var(--display);
    font-weight: 800;
    font-size: 34px;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .cheat-lvl__name {
    font-size: 15px;
    font-weight: 600;
    color: var(--ink-mid);
  }
  .cheat-lvl__count {
    margin-top: 10px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--mint-ink);
  }
  .cheat-lvl::after {
    content: "→";
    position: absolute;
    right: 16px;
    bottom: 14px;
    font-family: var(--mono);
    font-weight: 700;
    font-size: 15px;
    color: var(--ink-soft);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.18s ease, transform 0.18s ease;
  }
  .cheat-lvl:hover::after { opacity: 1; transform: none; }

  @media (max-width: 640px) {
    .cheats-index { padding: 26px 0 56px; }
    .cheats-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .cheat-lvl { padding: 18px 16px; }
    .cheat-lvl::after { display: none; }
  }
</style>
