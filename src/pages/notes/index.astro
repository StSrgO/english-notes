---
import Base from "../../layouts/Base.astro";
import { LEVELS } from "../../data/lesson-order.js";

const files = import.meta.glob("../../data/cheats/*.json", { eager: true, import: "default" });
const levels = Object.values(files)
  .filter((d) => d && d.level && Array.isArray(d.topics))
  .sort((a, b) => LEVELS.indexOf(a.level) - LEVELS.indexOf(b.level));
const total = levels.reduce((n, d) => n + d.topics.length, 0);
---

<Base title="Краткие заметки по грамматике — EnglishNotes" description={`Заметки по грамматике английского: краткие схемы ${total} тем по уровням A0–C2 — когда используется, формула, примеры, частая ошибка.`}>
  <section class="cheats-index wrap">
    <nav class="cheats-lvls" aria-label="Уровни заметок">
      {levels.map((d) => (
        <a href={"#" + d.level} class="cheats-lvls__link" data-level-link data-level={d.level}>
          <span class="cheats-lvls__lvl">{d.level}</span>
          <span class="cheats-lvls__n">{d.topics.length}</span>
        </a>
      ))}
    </nav>

    <header class="cheats-index__head">
      <p class="eyebrow">grammar · notes</p>
      <h1 class="cheats-index__h1"><span class="hl-mark">Краткие заметки</span></h1>
      <p class="cheats-index__lead">
        Краткие схемы по темам грамматики для быстрого повторения: когда используется,
        формула, один-два примера и частая ошибка — без истории и длинных объяснений.
        {total} тем на {levels.length} уровнях.
      </p>
    </header>

    <div class="cheats-grid">
      {levels.map((d) => {
        const level = d.level;
        const pad = (i) => String(i + 1).padStart(2, "0");
        return (
          <a href={"/notes/" + level.toLowerCase()} class="cheat-lvl" id={level} data-level-block>
            <span class="cheat-lvl__head">
              <span class="cheat-lvl__code">{level}</span>
              <span class="cheat-lvl__count">{d.topics.length} {d.topics.length === 1 ? "тема" : "тем"}</span>
            </span>
            <span class="cheat-lvl__topics">
              {d.topics.map((t, i) => (
                <span class="cheat-lvl__topic">
                  <span class="cheat-lvl__n">{pad(i)}</span>
                  <span class="cheat-lvl__t">{t.title}</span>
                </span>
              ))}
            </span>
          </a>
        );
      })}
    </div>
  </section>
</Base>

<style>
  .cheats-index { padding: 44px 0 72px; }
  .cheats-index__head { margin-bottom: 34px; }
  .cheats-index__h1 {
    font-family: var(--display-serif);
    font-weight: 800;
    font-size: clamp(34px, 5vw, 54px);
    letter-spacing: -0.01em;
    line-height: 1.05;
    margin: 12px 0 14px;
  }
  .cheats-index__lead {
    max-width: 62ch;
    font-family: var(--display-serif);
    font-size: 18px;
    line-height: 1.7;
    color: var(--ink-mid);
    font-weight: 500;
    margin: 0;
  }

  .cheats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 16px;
  }
  .cheat-lvl {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px;
    background: var(--surface);
    border: 1.5px solid var(--line);
    border-radius: 16px;
    scroll-margin-top: 96px;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .cheat-lvl:hover {
    transform: translateY(-3px);
    border-color: var(--mint-deep);
    box-shadow: var(--shadow-sm);
  }
  .cheat-lvl__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }
  .cheat-lvl__code {
    font-family: var(--display);
    font-weight: 800;
    font-size: 32px;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .cheat-lvl__count {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--mint-ink);
    white-space: nowrap;
  }
  .cheat-lvl__topics {
    display: flex;
    flex-direction: column;
  }
  .cheat-lvl__topic {
    display: flex;
    align-items: baseline;
    gap: 9px;
    padding: 6px 0;
    border-top: 1px solid var(--line);
    min-width: 0;
  }
  .cheat-lvl__topic:first-child { border-top: none; }
  .cheat-lvl__n {
    flex: 0 0 auto;
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    color: var(--mint-ink);
  }
  .cheat-lvl__t {
    font-size: 13.5px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--ink);
    min-width: 0;
  }
  .cheat-lvl:hover .cheat-lvl__t { color: var(--ink-mid); }

  /* мобильный скролл-бар уровней — правило update222: лента сразу
     под шапкой (первый элемент), фон — бумага + фактура --bar-paper */
  .cheats-lvls { display: none; }
  @media (max-width: 920px) {
    .cheats-index { padding-top: 0; }
    .cheats-index__head { margin-top: 22px; }
    .cheats-lvls {
      position: sticky;
      top: 60px;
      z-index: 15;
      display: flex;
      flex-direction: row;
      gap: 8px;
      overflow-x: auto;
      padding: 10px 2px;
      margin: 0 -2px;
      background-color: var(--paper);
      background-image: var(--bar-paper);
      border-bottom: 1px solid var(--line);
      scrollbar-width: none;
    }
    .cheats-lvls::-webkit-scrollbar { display: none; }
    .cheat-lvl { scroll-margin-top: 140px; }
    .cheats-lvls__link {
      flex: 0 0 auto;
      display: inline-flex;
      align-items: baseline;
      gap: 8px;
      padding: 8px 14px;
      border-radius: 11px;
      font-family: var(--display);
      font-weight: 800;
      font-size: 19px;
      letter-spacing: -0.01em;
      color: var(--ink);
      position: relative;
      transition: background 0.18s ease, color 0.18s ease, transform 0.18s ease;
    }
    .cheats-lvls__link:hover {
      background: var(--mint);
      color: var(--mint-ink);
      transform: translateX(3px);
    }
    .cheats-lvls__link.is-active,
    .cheats-lvls__link:active {
      background: var(--mint-ink);
      color: var(--paper);
    }
    .cheats-lvls__n {
      font-family: var(--mono);
      font-size: 12px;
      font-weight: 600;
      opacity: 0.55;
    }
  }

  @media (max-width: 640px) {
    .cheats-index { padding: 0 0 56px; }
    .cheats-grid { grid-template-columns: minmax(0, 1fr); gap: 14px; }
    .cheat-lvl { padding: 18px 16px; }
  }
</style>
