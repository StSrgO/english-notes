---
import Base from "../../layouts/Base.astro";
import { LEVELS } from "../../data/lesson-order.js";

const files = import.meta.glob("../../data/cheats/*.json", { eager: true, import: "default" });
const levels = Object.values(files)
  .filter((d) => d && d.level && Array.isArray(d.topics))
  .sort((a, b) => LEVELS.indexOf(a.level) - LEVELS.indexOf(b.level));
const total = levels.reduce((n, d) => n + d.topics.length, 0);
---

<Base title="Краткие заметки по грамматике — EnglishNotes" description={`Заметки по грамматике английского: краткие схемы ${total} тем по уровням A0–C2 — когда используется, формула, примеры, частая ошибка.`}>
  <section class="cheats-index wrap">
    <header class="cheats-index__head">
      <p class="eyebrow">grammar · notes</p>
      <h1 class="cheats-index__h1"><span class="hl-mark">Краткие заметки</span></h1>
      <p class="cheats-index__lead">
        Краткие схемы по темам грамматики для быстрого повторения: когда используется,
        формула, один-два примера и частая ошибка — без истории и длинных объяснений.
        {total} тем на {levels.length} уровнях.
      </p>
    </header>

    <div class="cheats-grid">
      {levels.map((d) => {
        const level = d.level;
        const pad = (i) => String(i + 1).padStart(2, "0");
        return (
          <a href={"/notes/" + level.toLowerCase()} class="cheat-lvl">
            <span class="cheat-lvl__head">
              <span class="cheat-lvl__code">{level}</span>
              <span class="cheat-lvl__count">{d.topics.length} {d.topics.length === 1 ? "тема" : "тем"}</span>
            </span>
            <span class="cheat-lvl__topics">
              {d.topics.map((t, i) => (
                <span class="cheat-lvl__topic">
                  <span class="cheat-lvl__n">{pad(i)}</span>
                  <span class="cheat-lvl__t">{t.title}</span>
                </span>
              ))}
            </span>
          </a>
        );
      })}
    </div>
  </section>
</Base>

<style>
  .cheats-index { padding: 44px 0 72px; }
  .cheats-index__head { margin-bottom: 34px; }
  .cheats-index__h1 {
    font-family: var(--display-serif);
    font-weight: 800;
    font-size: clamp(34px, 5vw, 54px);
    letter-spacing: -0.01em;
    line-height: 1.05;
    margin: 12px 0 14px;
  }
  .cheats-index__lead {
    max-width: 62ch;
    font-family: var(--display-serif);
    font-size: 18px;
    line-height: 1.7;
    color: var(--ink-mid);
    font-weight: 500;
    margin: 0;
  }

  .cheats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 16px;
  }
  .cheat-lvl {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px;
    background: var(--surface);
    border: 1.5px solid var(--line);
    border-radius: 16px;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .cheat-lvl:hover {
    transform: translateY(-3px);
    border-color: var(--mint-deep);
    box-shadow: var(--shadow-sm);
  }
  .cheat-lvl__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }
  .cheat-lvl__code {
    font-family: var(--display);
    font-weight: 800;
    font-size: 32px;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .cheat-lvl__count {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--mint-ink);
    white-space: nowrap;
  }
  .cheat-lvl__topics {
    display: flex;
    flex-direction: column;
  }
  .cheat-lvl__topic {
    display: flex;
    align-items: baseline;
    gap: 9px;
    padding: 6px 0;
    border-top: 1px solid var(--line);
    min-width: 0;
  }
  .cheat-lvl__topic:first-child { border-top: none; }
  .cheat-lvl__n {
    flex: 0 0 auto;
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    color: var(--mint-ink);
  }
  .cheat-lvl__t {
    font-size: 13.5px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--ink);
    min-width: 0;
  }
  .cheat-lvl:hover .cheat-lvl__t { color: var(--ink-mid); }

  @media (max-width: 640px) {
    .cheats-index { padding: 26px 0 56px; }
    .cheats-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .cheat-lvl { padding: 16px 14px; }
  }
</style>
