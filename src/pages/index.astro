---
import Base from '../layouts/Base.astro';
import grammar from '../data/grammar.json';
import recs from '../data/recommendations.json';
const levels = ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'];
const sections = [
  { ico: '📖', title: 'Грамматика', href: '/grammar', soon: false },
  { ico: '🗂️', title: 'Словарь', href: '/grammar', soon: true },
  { ico: '🎧', title: 'Аудирование', href: '/grammar', soon: true },
  { ico: '🎤', title: 'Говорение', href: '/grammar', soon: true },
];
---
<Base title="EnglishNotes — учим английский по-настоящему">
  <section class="hero wrap">
    <div class="hero__grid">
      <div data-reveal>
        <p class="eyebrow">language · skill · /ˈɪ.ɡlɪʃ/</p>
        <h1>Учи английский,<br><span class="hl-mark">по‑настоящему.</span></h1>
        <p class="muted" style="max-width:46ch">Грамматика, разложенная по уровням CEFR — от A1 до C2. Читай правила, разбирай примеры и отмечай пройденное. Без воды и регистрации.</p>
        <div class="levels">
          {levels.map((l) => <a href={'/grammar#' + l} class="level-dot" title={'Уровень ' + l}>{l}</a>)}
        </div>
        <a href="/grammar" class="btn btn--coral">Открыть грамматику →</a>
      </div>
      <div class="hero__visual" data-reveal>
        <div class="sticky">Подборка<br>недели ✦</div>
        <div class="recs">
          {recs.map((r) => (
            <a href={r.href} target="_blank" rel="noopener noreferrer" class="rec">
              <span class={'rec__cover rec__cover--' + r.type} aria-hidden="true">
                {r.type === 'podcast' && <span class="eq"><i></i><i></i><i></i></span>}
                {r.type === 'video' && <span class="play"></span>}
                {r.type === 'book' && <span class="pages"></span>}
              </span>
              <span class="rec__body">
                <span class="rec__type">{r.typeLabel} · {r.level}</span>
                <span class="rec__title">{r.title}</span>
                <span class="rec__meta">{r.meta}</span>
              </span>
              <span class="rec__go" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="section__head" data-reveal>
      <h2>Разделы</h2>
      <div class="ring-wrap">
        <svg class="ring" viewBox="0 0 36 36" data-ring>
          <circle class="ring__bg" cx="18" cy="18" r="16" pathLength="100" />
          <circle class="ring__fg" cx="18" cy="18" r="16" pathLength="100" stroke-dasharray="0 100" />
        </svg>
        <span class="ring-label" data-ring-label>0%</span>
      </div>
    </div>
    <div class="cards">
      {sections.map((s) => (
        <a href={s.href} class={'card' + (s.soon ? ' is-soon' : '')} data-reveal>
          <div class="ico">{s.ico}</div>
          <h3>{s.title}</h3>
          <span class="muted" style="font-size:14px">{s.soon ? 'скоро' : 'перейти'}</span>
        </a>
      ))}
      <div class="card card--progress" data-reveal>
        <span class="muted" style="font-size:13px">Изучено тем</span>
        <strong style="font-family:var(--display);font-size:22px" data-count>0 / {grammar.topics.length}</strong>
      </div>
    </div>
  </section>
</Base>