---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import phrases from '../data/phrases.json';
import recs from '../data/recommendations.json';

const levels = ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'];
const sections = [
  { ico: 'book', title: 'Грамматика', href: '/grammar', soon: false },
  { ico: 'cards', title: 'Словарь', href: '/grammar', soon: true },
  { ico: 'headphones', title: 'Аудирование', href: '/grammar', soon: true },
  { ico: 'mic', title: 'Говорение', href: '/grammar', soon: true },
];

const now = new Date();
const start = new Date(now.getFullYear(), 0, 0);
const seed = Math.floor((now.getTime() - start.getTime()) / 86400000);

const phrase = phrases[seed % phrases.length];

const typeOrder = ['podcast', 'video', 'book', 'series', 'song'];
const typeIcon = { podcast: 'eq', video: 'play', book: 'book', series: 'film', song: 'note' };
const picks = typeOrder.map((t, i) => {
  const pool = recs.filter((r) => r.type === t);
  return pool[(seed + i) % pool.length];
});
---
<Base title="EnglishNotes — учим английский по-настоящему">
  <section class="hero wrap">
    <div class="hero__grid">
      <div class="hero__lead" data-reveal>
        <p class="eyebrow">language · skill · a1–c2</p>
        <h1>Учи английский,<br><span class="hl-mark">по-настоящему.</span></h1>
        <p class="muted hero__sub">Грамматика, разложенная по уровням CEFR — от A1 до C2. Читай правила, разбирай примеры и отмечай пройденное. Без воды и регистрации.</p>
        <div class="levels">
          {levels.map((l) => <a href={'/grammar#' + l} class="level-dot" title={'Уровень ' + l}>{l}</a>)}
        </div>
        <a href="/grammar" class="btn btn--coral">Открыть грамматику →</a>
      </div>

      <div class="hero__visual" data-reveal>
        <section class="daily">
          <h2 class="block-label"><span class="dot"></span>фраза дня</h2>
          <figure class="quote-card">
            <span class="quote-card__mark" aria-hidden="true">&ldquo;</span>
            <blockquote class="quote-card__en">{phrase.en}</blockquote>
            <p class="quote-card__ru">{phrase.ru}</p>
            {phrase.author && (
              <figcaption class="quote-card__by">— {phrase.author}{phrase.source ? ', ' + phrase.source : ''}</figcaption>
            )}
          </figure>
        </section>

        <section class="daily">
          <h2 class="block-label"><span class="dot"></span>подборка дня</h2>
          <div class="picks">
            {picks.map((r) => (
              <a href={r.href} target="_blank" rel="noopener noreferrer" class="pick">
                <span class={'pick__cover pick__cover--' + r.type}>
                  <Icon name={typeIcon[r.type]} accent={false} size={28} />
                </span>
                <span class="pick__body">
                  <span class="pick__type">{r.typeLabel} · {r.level}</span>
                  <span class="pick__title">{r.title}</span>
                  <span class="pick__meta">{r.meta}</span>
                </span>
                <span class="pick__go" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </section>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <h2 class="block-label"><span class="dot"></span>разделы</h2>
    <div class="cards">
      {sections.map((s) => (
        <a href={s.href} class={'card' + (s.soon ? ' is-soon' : '')} data-reveal>
          <div class="ico"><Icon name={s.ico} size={46} /></div>
          <h3>{s.title}</h3>
          <span class="muted" style="font-size:14px">{s.soon ? 'скоро' : 'перейти'}</span>
        </a>
      ))}
    </div>
  </section>
</Base>