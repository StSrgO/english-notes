---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import phrases from '../data/phrases.json';
import recs from '../data/recommendations.json';

const levels = ['A0', 'A1', 'A2', 'B1', 'B2', 'C1', 'C2'];
const sections = [
  { img: 'grammar',    title: 'Грамматика',   href: '/grammar' },
  { img: 'vocabulary', title: 'Словарь',      href: '/grammar' },
  { img: 'listening',  title: 'Аудирование',  href: '/grammar' },
  { img: 'speaking',   title: 'Говорение',    href: '/grammar' },
];

// Номер дня в году (1-based) из календарных полей: не зависит от часового пояса
// и перехода на летнее время (разница epoch-моментов «плывёт» на DST).
const dayOfYear = (d) =>
  Math.floor((Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) - Date.UTC(d.getFullYear(), 0, 1)) / 86400000) + 1;
// Статическая сборка: ниже — контент на дату сборки, фолбэк для пользователей без JS.
// Реальная ротация по локальной дате посетителя — в скрипте внизу страницы.
const seed = dayOfYear(new Date());

const phrase = phrases[seed % phrases.length];

const typeOrder = ['podcast', 'video', 'book', 'series', 'song'];
const typeIcon = { podcast: 'eq', video: 'play', book: 'book', series: 'film', song: 'note' };
// Ротация: множители (13, 11) взаимно просты с длинами пулов — каждый тип идёт
// по своему «перемешанному» кругу: соседние дни не повторяются, порядок не выглядит
// последовательным, полный цикл = длине пула (для пулов 400+ — больше года).
const picks = typeOrder.map((t, i) => {
  const pool = recs.filter((r) => r.type === t);
  return pool[(seed * 13 + i * 11) % pool.length];
});
---
<Base title="EnglishNotes — Выбери уровень. Выбери стиль." pageClass="home-page">
  <section class="hero wrap">
    <div class="hero__grid">
      <div class="hero__lead" data-reveal>
        <div class="hero__copy">
          <p class="eyebrow">classic · rock-n-roll · grammar · a0–c2</p>
          <h1>Tenses, Conditions and<br><span class="hero__invert">Two Fucking Voices</span></h1>
          <p class="hero__sub">Позвольте, я расскажу вам историю. В начале никто не знает, чем всё закончится. У герой пока без злодея. Путешественник ещё не знает дороги. Влюблённый ещё не встретил те самые глаза. Музыкант ещё не взял гитару. Читатель переворачивает первую страницу и понятия не имеет, что ждёт его дальше. В этом и есть вся прелесть начала: всё возможно, пока история ещё не рассказана. И самое интересное: они ещё не знают, что первый абзац уже написан.<br><span class="hero__sub-en">Hey! Ho! Let’s go!</span></p>
        </div>

        <div class="tiles">
          {sections.map((s) => (
            <a href={s.href} class="tile" data-reveal aria-label={s.title} title={s.title}>
              <img src={'/sections/' + s.img + '.png'} alt={s.title} class="tile__img" loading="lazy" />
              <span class="tile__go" aria-hidden="true">→</span>
            </a>
          ))}
        </div>

        <p class="hero__punch" aria-hidden="true"></p>
        <p class="cfr-note" data-reveal><span class="cfr-grp">A0–A2 — начать и разобраться</span><span class="cfr-sep"> · </span><span class="cfr-grp">B1–B2 — говорить и понимать</span><span class="cfr-sep"> · </span><span class="cfr-grp">C1–C2 — читать, чувствовать и владеть</span></p>
        <div class="levels levels--text">
            {levels.map((l, i) => (
              <>
                {i > 0 && <span class="lvl-arrow" aria-hidden="true">→</span>}
                <a href={'/grammar#' + l} class="level-link" title={'Уровень ' + l}>{l}</a>
              </>
            ))}
          </div>
        <div class="levels levels--img">
          {levels.map((l) => (
            <a href={'/grammar#' + l} class="lvl-img" title={'Уровень ' + l} aria-label={'Уровень ' + l}>
              <img src={'/levels/' + l.toLowerCase() + '.png'} alt={'Уровень ' + l} loading="lazy" />
            </a>
          ))}
        </div>
      </div>

      <div class="hero__visual" data-reveal>
        <section class="daily">
          <h2 class="block-label">фраза дня</h2>
          <figure class="quote-card">
            <blockquote class="quote-card__en">{phrase.en}</blockquote>
            <p class="quote-card__ru">{phrase.ru}</p>
            {phrase.author && (
              <figcaption class="quote-card__by">— {phrase.author}{phrase.source ? ', ' + phrase.source : ''}</figcaption>
            )}
          </figure>
        </section>

        <section class="daily">
          <h2 class="block-label">подборка дня</h2>
          <div class="picks">
            {picks.map((r) => (
              <a href={r.href} target="_blank" rel="noopener noreferrer" class="pick">
                <span class={'pick__cover pick__cover--' + r.type}>
                  <img src={'/picks/' + r.type + '.png'} alt="" class="pick__ico" loading="lazy" />
                </span>
                <span class="pick__body">
                  <span class="pick__type">{r.typeLabel} · {r.level}</span>
                  <span class="pick__title">{r.title}</span>
                  <span class="pick__meta">{r.meta}</span>
                </span>
                <span class="pick__go" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </section>
      </div>
    </div>
  
  </section>
  <script>
    // «Фраза дня»: карточка фиксированной высоты, шрифт масштабируется,
    // чтобы текст любой длины вписывался полностью.
    (function () {
      const card = document.querySelector('.quote-card');
      if (!card) return;
      const parts = [card.querySelector('.quote-card__en'), card.querySelector('.quote-card__ru'), card.querySelector('.quote-card__by')].filter(Boolean);
      const MIN_SCALE = 0.3;
      const fits = () => card.scrollHeight <= card.clientHeight + 1;

      function fit() {
        parts.forEach((el) => { el.style.fontSize = ''; });
        const base = parts.map((el) => parseFloat(getComputedStyle(el).fontSize));
        if (fits()) return;
        // бинарный поиск максимального масштаба, при котором всё влезает
        let lo = MIN_SCALE, hi = 1;
        for (let i = 0; i < 12; i++) {
          const mid = (lo + hi) / 2;
          parts.forEach((el, j) => { el.style.fontSize = (base[j] * mid) + 'px'; });
          if (fits()) lo = mid; else hi = mid;
        }
        parts.forEach((el, j) => { el.style.fontSize = (base[j] * lo) + 'px'; });
      }

      fit();
      window.addEventListener('resize', fit);
      window.addEventListener('pageshow', fit);
      window.addEventListener('daily-updated', fit);
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
      if (window.ResizeObserver) new ResizeObserver(fit).observe(card);
    })();

    // Заголовок hero: на мобильных не должен распадаться больше чем на 2 строки.
    // Шрифт плавно уменьшается, пока каждая из двух частей (до <br> и после)
    // не поместится в одну строку в пределах экрана. (inline !important
    // нужен, чтобы перебить !important из мобильных медиа-правил CSS.)
    (function () {
      const h1 = document.querySelector('.hero h1');
      if (!h1) return;
      const MIN_SCALE = 0.45;

      // ширина самой широкой части заголовка (nowrap + width:max-content:
      // <br> делит текст на 2 строки, ширина блока = самая длинная строка)
      const segWidth = () => {
        h1.style.setProperty('white-space', 'nowrap');
        h1.style.setProperty('width', 'max-content', 'important');
        const w = h1.getBoundingClientRect().width;
        h1.style.setProperty('width', '');
        h1.style.setProperty('white-space', '');
        return w;
      };

      function fit() {
        if (window.innerWidth > 768) return;
        h1.style.setProperty('font-size', '');
        const base = parseFloat(getComputedStyle(h1).fontSize);
        const containerW = h1.parentElement.getBoundingClientRect().width;
        if (segWidth() <= containerW - 2) return;
        // бинарный поиск максимального размера, при котором обе части — в одну строку
        let lo = MIN_SCALE, hi = 1;
        for (let i = 0; i < 10; i++) {
          const mid = (lo + hi) / 2;
          h1.style.setProperty('font-size', (base * mid) + 'px', 'important');
          if (segWidth() <= containerW - 2) lo = mid; else hi = mid;
        }
        h1.style.setProperty('font-size', (base * lo) + 'px', 'important');
      }

      fit();
      window.addEventListener('resize', fit);
      window.addEventListener('pageshow', fit);
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
    })();

    // «Фраза дня» и «подборка дня»: ротация по локальной дате посетителя.
    // Статическая сборка замораживает контент на дату деплоя, поэтому выбор дня
    // пересчитывается в браузере из компактных JSON-эндпоинтов /daily/*.json.
    // Пока данные грузятся — виден контент из сборки (фолбэк).
    (function () {
      const TYPE_ORDER = ['podcast', 'video', 'book', 'series', 'song'];
      const TYPE_LABEL = { podcast: 'Подкаст', video: 'Видео', book: 'Книга', series: 'Сериал', song: 'Разбор песни' };
      const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

      const card = document.querySelector('.quote-card');
      const picksWrap = document.querySelector('.picks');
      if (!card || !picksWrap) return;

      Promise.all([
        fetch('/daily/phrases.json').then((r) => r.json()),
        fetch('/daily/recs.json').then((r) => r.json()),
      ])
        .then(([phrases, recs]) => {
          const now = new Date();
          const seed = Math.floor((Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()) - Date.UTC(now.getFullYear(), 0, 1)) / 86400000) + 1;

          const [en, ru, author, source] = phrases[seed % phrases.length];
          card.innerHTML =
            '<blockquote class="quote-card__en">' + esc(en) + '</blockquote>' +
            '<p class="quote-card__ru">' + esc(ru) + '</p>' +
            (author ? '<figcaption class="quote-card__by">— ' + esc(author) + (source ? ', ' + esc(source) : '') + '</figcaption>' : '');

          picksWrap.innerHTML = TYPE_ORDER.map((t, i) => {
            const pool = recs.filter((x) => x[0] === t);
            const [type, level, title, meta, href] = pool[(seed * 13 + i * 11) % pool.length];
            return (
              '<a href="' + esc(href) + '" target="_blank" rel="noopener noreferrer" class="pick">' +
              '<span class="pick__cover pick__cover--' + type + '">' +
              '<img src="/picks/' + type + '.png" alt="" class="pick__ico" loading="lazy" />' +
              '</span>' +
              '<span class="pick__body">' +
              '<span class="pick__type">' + TYPE_LABEL[type] + ' · ' + level + '</span>' +
              '<span class="pick__title">' + esc(title) + '</span>' +
              '<span class="pick__meta">' + esc(meta) + '</span>' +
              '</span>' +
              '<span class="pick__go" aria-hidden="true">↗</span>' +
              '</a>'
            );
          }).join('');

          window.dispatchEvent(new Event('daily-updated'));
        })
        .catch(() => {}); // сбой загрузки JSON — остаётся контент из сборки
    })();
  </script>
</Base>