---
export interface Props { name: string; accent?: boolean; size?: number; rough?: boolean; }
const { name, accent = true, size = 24 } = Astro.props;
// gentle wobble for real glyphs (>=24px); tiny text markers stay perfectly
// clean so they read on tinted backgrounds. Coloring (hl) sits UNDER the
// outline; both pass through #sketch-rough (in Base.astro) for a light
// hand-drawn tremor вЂ” NOT a heavy distortion.
const rough = Astro.props.rough !== undefined ? Astro.props.rough : size >= 24;

const I: Record<string, { c: string; hl: string }> = {
  book: {
    c: '<path d="M12 6.5C10.3 5.2 7.8 4.8 4 5.1v12.8c3.8-.3 6.3.1 8 1.4 1.7-1.3 4.2-1.7 8-1.4V5.1c-3.8-.3-6.3.1-8 1.4Z"/><path d="M12 6.5v12.8"/><path d="M14.4 8.9h3.2M14.4 11.3h3.2" stroke-width="1.4"/>',
    hl: '<path d="M5.8 7.2l2.5-.2v8.2l-2.5.2Z" fill="var(--marker)" stroke="none" opacity=".8"/><path d="M3.3 4.7l3.4-.4" stroke="var(--marker)" stroke-width="3.4" stroke-linecap="round" fill="none" opacity=".85"/>'
  },
  cards: {
    c: '<rect x="7.5" y="6.5" width="11" height="9" rx="2" transform="rotate(8 13 11)"/><rect x="5" y="9" width="11.5" height="9.5" rx="2.2"/><path d="M7.8 13h6M7.8 15.6h3.6"/><path d="M9.6 9V6.2a1.5 1.5 0 0 1 3 0V9"/>',
    hl: '<path d="M7.2 17.7l6 .8" stroke="var(--coral)" stroke-width="3" stroke-linecap="round" fill="none" opacity=".75"/>'
  },
  headphones: {
    c: '<path d="M4.5 13.5v-1a7.5 7.5 0 0 1 15 0v1" stroke-width="3"/><rect x="3" y="12.5" width="4" height="7" rx="2"/><rect x="17" y="12.5" width="4" height="7" rx="2"/>',
    hl: '<rect x="3.5" y="13.1" width="3" height="5.8" rx="1.5" fill="var(--marker)" stroke="none" opacity=".8"/><rect x="17.5" y="13.1" width="3" height="5.8" rx="1.5" fill="var(--coral)" stroke="none" opacity=".75"/>'
  },
  mic: {
    c: '<rect x="9" y="3" width="6" height="9.5" rx="3"/><path d="M6 9.5v1.5a6 6 0 0 0 12 0V9.5"/><path d="M12 17v3.2M9 20.4h6"/>',
    hl: '<rect x="9.7" y="3.7" width="4.6" height="8.1" rx="2.3" fill="var(--marker)" stroke="none" opacity=".6"/><path d="M13.6 2.6l1.4 1.2" stroke="var(--marker)" stroke-width="3" stroke-linecap="round" fill="none" opacity=".8"/>'
  },
  target: {
    c: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="1.2" fill="currentColor" stroke="none"/>',
    hl: '<path d="M5 9.6a8 8 0 0 1 7.4-5.3" stroke="var(--coral)" stroke-width="3.6" stroke-linecap="round" fill="none" opacity=".8"/>'
  },
  chat: {
    c: '<path d="M4.5 6h15a1.6 1.6 0 0 1 1.6 1.6v6.2a1.6 1.6 0 0 1-1.6 1.6H10l-4 3.2v-3.2H4.5A1.6 1.6 0 0 1 2.9 13.8V7.6A1.6 1.6 0 0 1 4.5 6Z"/><circle cx="8.5" cy="10.7" r="1.05" fill="currentColor" stroke="none"/><circle cx="12" cy="10.7" r="1.05" fill="currentColor" stroke="none"/><circle cx="15.5" cy="10.7" r="1.05" fill="currentColor" stroke="none"/>',
    hl: ''
  },
  arrows: {
    c: '<path d="M8.5 9 4.5 12l4 3M15.5 9l4 3-4 3M5 12h14"/>',
    hl: '<path d="M8.5 9.4 5.2 12 8.5 14.6 8.5 13.1 15.5 13.1 15.5 14.6 18.8 12 15.5 9.4 15.5 10.9 8.5 10.9 Z" fill="var(--marker)" stroke="none" opacity=".75"/>'
  },
  arrow: {
    c: '<path d="M4.5 12h13M12.5 7l5 5-5 5"/>',
    hl: '<path d="M6 14.2h9" stroke="var(--coral)" stroke-width="3.4" stroke-linecap="round" fill="none" opacity=".75"/>'
  },
  pencil: {
    c: '<path d="M15.2 4.3l4.5 4.5L8.2 20.3l-4.7 1 1-4.7Z"/><path d="M13.2 6.3l4.5 4.5"/><path d="M5 16.3l2.7 2.7"/>',
    hl: '<path d="M14.4 5.8l2.8 2.8-6 6-2.8-2.8Z" fill="var(--marker)" stroke="none" opacity=".7"/><path d="M4.5 18.7l1.4 1.4" stroke="var(--coral)" stroke-width="3.4" stroke-linecap="round" fill="none" opacity=".85"/>'
  },
  bulb: {
    c: '<path d="M9 15.2a6.2 6.2 0 1 1 6 0c-.7.6-1 1.3-1 2.1v.2h-4v-.2c0-.8-.3-1.5-1-2.1Z"/><path d="M10 20h4M10.6 22h2.8"/><path d="M12 2.6v-1M4.6 5.6 3.7 4.7M19.4 5.6l.9-.9M3.2 12H2M22 12h-1.2"/>',
    hl: '<path d="M15.6 8a4.2 4.2 0 0 1 0 6" stroke="var(--marker)" stroke-width="3.6" stroke-linecap="round" fill="none" opacity=".8"/>'
  },
  eq: {
    c: '<line x1="6" y1="17.5" x2="6" y2="11" stroke-width="2.6"/><line x1="10" y1="17.5" x2="10" y2="6.5" stroke-width="2.6"/><line x1="14" y1="17.5" x2="14" y2="13" stroke-width="2.6"/><line x1="18" y1="17.5" x2="18" y2="8.5" stroke-width="2.6"/>',
    hl: '<path d="M10 7.2v9" stroke="var(--marker)" stroke-width="3.4" stroke-linecap="round" fill="none" opacity=".75"/><path d="M18 9.2v7" stroke="var(--coral)" stroke-width="3.4" stroke-linecap="round" fill="none" opacity=".75"/>'
  },
  play: {
    c: '<circle cx="12" cy="12" r="8.4"/><path d="M10 8.3l5.8 3.7L10 15.7Z"/>',
    hl: ''
  },
  film: {
    c: '<rect x="3.5" y="5.5" width="17" height="13" rx="1.6"/><path d="M8 5.5v13M16 5.5v13M3.5 9.3h4.5M3.5 12h4.5M3.5 14.7h4.5M16 9.3h4.5M16 12h4.5M16 14.7h4.5"/>',
    hl: '<path d="M5.4 5.4h11" stroke="var(--marker)" stroke-width="3.4" stroke-linecap="round" fill="none" opacity=".8"/>'
  },
  note: {
    c: '<path d="M10 17.2V5.8l8.2-2v9.4"/><circle cx="7.4" cy="17.2" r="2.6"/><circle cx="15.6" cy="13.2" r="2.6"/><path d="M19.8 9c1 .8 1 2.2 0 3M21.4 7.4c1.8 1.5 1.8 4.8 0 6.2"/>',
    hl: '<circle cx="7.4" cy="17.2" r="2.6" fill="var(--marker)" stroke="none" opacity=".75"/>'
  },
  check: {
    c: '<path d="M4.5 12.5l4.8 4.8L19.5 6.5"/>',
    hl: '<path d="M5.8 13.4l4.2 4.2 8.6-9" stroke="var(--coral)" stroke-width="3.6" stroke-linecap="round" fill="none" opacity=".8"/>'
  },
  star: {
    c: '<path d="M12 3.6l2.5 5.1 5.6.8-4 3.9 1 5.6L12 16.9 6.9 19l1-5.6-4-3.9 5.6-.8Z"/>',
    hl: '<path d="M9.2 7.8l2.8-2.8 2.8 2.8" stroke="var(--coral)" stroke-width="3.2" stroke-linecap="round" fill="none" opacity=".75"/>'
  }
};
const ic = I[name] ?? { c: '', hl: '' };
const paint = (accent && ic.hl ? ic.hl : '') + ic.c;
const inner = rough ? '<g filter="url(#sketch-rough)">' + paint + '</g>' : paint;
---
<svg
  class="ico-svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2.1"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={inner}
></svg>