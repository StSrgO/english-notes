---
import Quiz from './Quiz.astro';

const { T, suffix, related, quizUi } = Astro.props;
const s = suffix || '';
const reveal = s === '' ? { 'data-reveal': '' } : {};

function esc(t) { return String(t).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
function raHtml(s) {
  let out = esc(String(s));
  out = out.replace(/[A-Za-z][^а-яА-ЯёЁ\n<>]*/g, (m) => {
    const core = m.replace(/[\s.,!?;:]+$/, '');
    const tail = m.slice(core.length);
    return core.length ? '<span class="ra-en">' + core + '</span>' + tail : m;
  });
  return out;
}
function highlight(text, tokens) {
  let out = esc(text);
  (tokens || []).forEach((tok) => { out = out.replace(esc(tok), '<mark class="hl">' + esc(tok) + '</mark>'); });
  return out;
}

function ideaHtml(text) {
  let out = esc(String(text));

  out = out.replace(
    /\[bold\]([\s\S]*?)\[\/bold\]/g,
    '<strong>$1</strong>'
  );

  return out;
}
---

<section id={'idea' + s} class="lv2-sec" data-spybase="idea" {...reveal}>
  <h2 class="lv2-h">Суть явления</h2>
  <div class="lv2-prose lv2-prose--drop">
    {T.idea.map((p) => <p set:html={ideaHtml(p)}></p>)}
  </div>
  
</section>

<section id={'why' + s} class="lv2-sec" data-spybase="why" {...reveal}>
  <h2 class="lv2-h">Зачем это нужно</h2>
  <ul class="why-list--v2">
    {T.why.map((w) => <li>{w}</li>)}
  </ul>

</section>

<section id={'context' + s} class="lv2-sec" data-spybase="context" {...reveal}>
  <h2 class="lv2-h">Живой контекст</h2>
  <div class="dialog">
    {T.context.lines.map((l) => (
      <div class="dialog__line">
        <div class="dialog__en">{l.en}</div>
        <div class="dialog__ru">{l.ru}</div>
      </div>
    ))}
    {T.context.note && <p class="dialog__note">{T.context.note}</p>}
  </div>

</section>

<section id={'russian' + s} class="lv2-sec" data-spybase="russian" {...reveal}>
  <h2 class="lv2-h">Взгляд через русский</h2>
  <div class="lv2-prose">{T.russianAngle.map((r) => <p>{r}</p>)}</div>

</section>

<section id={'learn' + s} class="lv2-sec" data-spybase="learn" {...reveal}>
  <h2 class="lv2-h">Как освоить</h2>
  <ol class="howto">
    {T.howToLearn.steps.map((st) => <li>{st}</li>)}
  </ol>
  {T.howToLearn.exercise && (
    <div class="try">
      {T.howToLearn.exercise.prompt && <p class="try__prompt">{T.howToLearn.exercise.prompt}</p>}
      <ol class="try__q">
        {T.howToLearn.exercise.items.map((it) => <li set:html={highlight(it.q, [])}></li>)}
      </ol>
      <details class="try__a">
        <summary>Показать ответы</summary>
        <ol>
          {T.howToLearn.exercise.items.map((it) => <li>{it.a}</li>)}
        </ol>
      </details>
    </div>
  )}

</section>

<section id={'reference' + s} class="lv2-sec" data-spybase="reference" {...reveal}>
  <h2 class="lv2-h">Справочник</h2>
  {T?.formula && <div class="lv2-formula">{T.formula}</div>}
    {T?.structure && Object.keys(T.structure).length > 0 && (
    <div class="lv2-struct">
      {Object.entries(T.structure)
        .filter(([_, value]) =>
          value !== null &&
          value !== undefined &&
          String(value).trim() !== ''
        )
        .map(([key, value]) => {

          const labels = {
            positive: "Утверждение",
            negative: "Отрицание",
            question: "Вопрос",

            affirmative: "Утверждение",
            statement: "Утверждение",

            short_answer: "Краткий ответ",
            shortAnswer: "Краткий ответ",

            wh_cleft: "Вопросительное выделение",
            it_cleft_person: "Выделение человека",
            it_cleft_thing: "Выделение предмета",
            focus_in_explanation: "Фокус в объяснении",

            subject_focus: "Фокус на подлежащем",
            object_focus: "Фокус на дополнении",
            time_focus: "Фокус на времени",
            place_focus: "Фокус на месте",

            present: "Настоящее время",
            past: "Прошедшее время",
            future: "Будущее время",

            singular: "Единственное число",
            plural: "Множественное число",

            question_form: "Вопросительная форма",
            negative_form: "Отрицательная форма",

            main_clause: "Главная часть",
            subordinate_clause: "Придаточная часть",

            active: "Активный залог",
            passive: "Пассивный залог",

            infinitive: "Инфинитив",
            gerund: "Герундий",
            participle: "Причастие",

            first_person: "Первое лицо",
            second_person: "Второе лицо",
            third_person: "Третье лицо",

            first_person_singular: "Первое лицо, ед. число",
            second_person_singular: "Второе лицо, ед. число",
            third_person_singular: "Третье лицо, ед. число",

            first_person_plural: "Первое лицо, мн. число",
            second_person_plural: "Второе лицо, мн. число",
            third_person_plural: "Третье лицо, мн. число"
          };

          const makeLabel = (rawKey) => {

            if (labels[rawKey]) {
              return labels[rawKey];
            }

            const readable = String(rawKey)
              .replace(/([a-z])([A-Z])/g, "$1 $2")
              .replace(/[_-]+/g, " ")
              .replace(/\s+/g, " ")
              .trim();

            return (
              readable.charAt(0).toUpperCase()
              + readable.slice(1)
            );
          };

          const label = makeLabel(key);

          let renderedValue;

          if (
            typeof value === "object" &&
            value !== null
          ) {

            renderedValue =
              value.text ??
              value.value ??
              value.example ??
              JSON.stringify(value);

          } else {

            renderedValue = String(value);

          }

          return (
            <div class="lv2-struct__row">

              <div class="lv2-struct__label">
                {label}
              </div>

              <div class="lv2-struct__value">
                {renderedValue}
              </div>

            </div>
          );
        })}
    </div>
  )}
  {T.markers && T.markers.length > 0 && (
    <div class="lv2-markers">
      {T.markers.map((m) => <span class="tag">{m}</span>)}
    </div>
  )}

  <h3 class="lv2-h3">Когда используется</h3>
  {T?.uses && T.uses.length > 0 && (
    <ul class="use-list--v2">
      {T.uses.map((u) => <li>{u}</li>)}
    </ul>
  )}

  <h3 class="lv2-h3">Правила и нюансы</h3>
  <ul class="lv2-rules">
    {T.rules.map((r) => <li><b>{r.title}.</b> {r.text}</li>)}
  </ul>

  <!-- АЛФАВИТ (отдельная секция) -->
{T.alphabet && T.alphabet.length > 0 && (
  <section id={'alphabet' + s} class="lv2-sec" data-spybase="alphabet">
    <h2 class="lv2-h">Алфавит</h2>
    <div class="alphabet-table">
      <div class="alphabet-grid">
        {T.alphabet.map((letter) => (
          <div class="alphabet-item">
            <span class="alphabet-letter">{letter.letter}</span>
            {letter.ipa && <span class="alphabet-ipa">{letter.ipa}</span>}
            {letter.example && <span class="alphabet-example">{letter.example}</span>}
            {letter.exampleRu && <span class="alphabet-example-ru">{letter.exampleRu}</span>}
          </div>
        ))}
      </div>
    </div>
  </section>
)}

  


  <h3 class="lv2-h3">Примеры по ситуациям</h3><div class="lv2-examples">
  {T.examples.map((g) => (
    <div class="lv2-exgroup">
      <div>
        {g.items.map((ex) => (
          <div class="lv2-ex">
            <div class="en" set:html={highlight(ex.en, ex.highlight)}></div>
            <div class="ru">{ex.ru}</div>
          </div>
        ))}
      </div>
    </div>
  ))}

  </div>
{T.mistakes && T.mistakes.length > 0 && (
    <div>
      <h3 class="lv2-h3">Типичные ошибки</h3>
      <div class="lv2-mistakes">
        <table>
          <thead><tr><th>Так не говорят</th><th>Так говорят</th></tr></thead>
          <tbody>
            {T.mistakes.map((m) => (
              <tr>
                <td><span class="w">✗ {m.wrong}</span><span class="n">{m.note}</span></td>
                <td class="r">✓ {m.right}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  )}

  {T.compare && T.compare.rows && T.compare.rows.length > 0 && (
    <div class="compare">
      <h3 class="lv2-h3">{T.compare.title}</h3>
      <table>
        <thead>
          <tr>
            <th>{T.compare.leftLabel}</th>
            {T.compare.centerLabel && <th>{T.compare.centerLabel}</th>}
            <th>{T.compare.rightLabel}</th>
          </tr>
        </thead>
        <tbody>
          {T.compare.rows.map((r) => (
            <tr>
              <td>{r.left}</td>
              {T.compare.centerLabel && <td>{r.center}</td>}
              <td>{r.right}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  {T.tips && T.tips.length > 0 && (
    <div>
      <h3 class="lv2-h3">Лайфхаки преподавателя</h3>
      <ul class="lv2-tips">
        {T.tips.map((t) => <li>{t}</li>)}
      </ul>
    </div>
  )}

</section>

{T.quiz && T.quiz.length > 0 && (
  <section id={'quiz' + s} class="lv2-sec" data-spybase="quiz" {...reveal}>
    <Quiz questions={T.quiz} ui={quizUi} />
  
</section>
)}

{quizUi && quizUi.morePracticeLead && (
    <div class="practice" data-reveal>
      <p class="practice__eye">{quizUi.morePractice}</p>
      <h3 class="practice__t">{quizUi.morePracticeLead}</h3>
      {quizUi.morePracticeText && <p class="practice__text">{quizUi.morePracticeText}</p>}
      {quizUi.morePracticeHref && (
        <a class="btn btn--coral practice__cta" href={quizUi.morePracticeHref} target="_blank" rel="noopener noreferrer">{quizUi.morePracticeCta} <span aria-hidden="true">&#8599;</span></a>
      )}
      {quizUi.morePracticeMore && quizUi.morePracticeMore.length > 0 && (
        <p class="practice__also">
          {quizUi.morePracticeAlsoLabel}{' '}
          {quizUi.morePracticeMore.map((m, i) => (
            <>{i > 0 && <span class="practice__sep">&#183;</span>}<a href={m.href} target="_blank" rel="noopener noreferrer">{m.label}</a></>
          ))}
        </p>
      )}
    </div>
  )}

  {related && related.length > 0 && (
  <section id={'related' + s} class="lv2-sec" data-spybase="related">
    <h2 class="lv2-h">Связанные темы</h2>
    <div class="related">
      {related.map((r) => <a href={'/grammar/' + r.slug} class="chip">{r.title}</a>)}
    </div>
  
</section>
)}


